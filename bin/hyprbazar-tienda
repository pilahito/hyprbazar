#!/usr/bin/env bash
# hyprbazar-tienda — buscador e instalador de temas de la comunidad.
#
# Busca en GitHub repositorios de temas/dotfiles para Hyprland, traduce su
# descripción al español y, al instalar, se queda solo con lo aprovechable:
#
#   · paletas de color (colors.json / theme.json) -> entran en el selector de
#     "Temas de color"
#   · fondos de pantalla (imágenes)               -> ~/Imágenes/Wallpapers/Comunidad
#
# Nada de esto toca tu configuración: no se copian binds, ni waybar, ni nada
# que pueda romper el escritorio. Solo se añaden temas y fondos que luego
# aplicas tú desde el selector.
#
# Uso:
#   tienda buscar "hyprland themes"     busca repos y traduce la descripción
#   tienda instalar owner/repo          descarga un repo y extrae temas/fondos
#   tienda instalados                   lista lo que ya has instalado
set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/tienda"
DATOS="${XDG_DATA_HOME:-$HOME/.local/share}/tienda"
PALETAS="${XDG_DATA_HOME:-$HOME/.local/share}/temas-paletas"
FONDOS="$HOME/Imágenes/Wallpapers/Comunidad"
TRAD="$CACHE/traducciones.json"
TOKEN_FILE="$HOME/.config/tienda/token"

log() { printf '%s\n' "$*" >&2; }
mk()  { mkdir -p "$1"; }
mk "$CACHE"; mk "$DATOS"

API="https://api.github.com"
AUTH=()
# Token: el de ~/.config/tienda/token o, si no hay, el de tu sesión de gh.
# Sin token GitHub solo deja 10 búsquedas por minuto y la tienda sale vacía.
TOKEN="$(cat "$TOKEN_FILE" 2>/dev/null || command gh auth token 2>/dev/null || true)"
[ -n "$TOKEN" ] && AUTH=(-H "Authorization: Bearer $TOKEN")

gh() { curl -sS -m 30 "${AUTH[@]}" -H "Accept: application/vnd.github+json" "$@"; }

# ───────────────────────── traducción (con caché) ───────────────────────────
traducir() {
    local texto="$1"
    [ -n "$texto" ] || return 0
    if [ -f "$TRAD" ]; then
        local guardado
        guardado="$(jq -r --arg t "$texto" '.[$t] // empty' "$TRAD" 2>/dev/null)"
        [ -n "$guardado" ] && { printf '%s' "$guardado"; return 0; }
    fi
    local url salida
    url="https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=es&dt=t&q=$(printf '%s' "$texto" | jq -sRr @uri)"
    salida="$(curl -sS -m 15 "$url" 2>/dev/null | jq -r '[.[0][][0]] | join("")' 2>/dev/null)"
    if [ -n "$salida" ] && [ "$salida" != "null" ]; then
        local tmp
        tmp="$(jq -c --arg t "$texto" --arg s "$salida" '. + {($t): $s}' "$TRAD" 2>/dev/null || echo "{}")"
        printf '%s\n' "$tmp" > "$TRAD"
        printf '%s' "$salida"
    fi
}

# ───────────────────────── buscar ───────────────────────────────────────────
buscar() {
    local consulta="${1:-dotfiles rice theme}"
    local q
    q="$(printf '%s' "$consulta" | jq -sRr @uri)"
    local json
    json="$(gh "$API/search/repositories?q=$q&sort=stars&order=desc&per_page=20")"
    if ! printf '%s' "$json" | jq -e '.items' >/dev/null 2>&1; then
        log "GitHub no devolvió resultados (¿límite de peticiones?)"
        printf '[]\n'
        return 1
    fi
    # traducción de las descripciones (secuencial, con caché)
    local i total
    total="$(printf '%s' "$json" | jq '.items | length')"
    i=0
    while [ "$i" -lt "$total" ]; do
        local desc
        desc="$(printf '%s' "$json" | jq -r --argjson i "$i" '.items[$i].description // ""')"
        if [ -n "$desc" ]; then
            traducir "$desc" >/dev/null 2>&1
        fi
        i=$((i + 1))
    done
    printf '%s' "$json" | jq -c '
      [ .items[] | {
          repo: .full_name,
          nombre: (.name),
          estrellas: .stargazers_count,
          descripcion: (.description // ""),
          avatar: .owner.avatar_url,
          url: .html_url,
          actualizado: .pushed_at
        } ]' | while read -r linea; do
        printf '%s' "$linea" | jq -c --slurpfile t /dev/null '.[]' 2>/dev/null || true
    done
    return 0
}

# versión simple y fiable: una línea JSON por repo, con "descripcion_es" y banner
buscar_simple() {
    local consulta="${1:-dotfiles rice theme}"
    python3 - "$consulta" "$TRAD" "$TOKEN" <<'PYEOF'
import json, re, sys, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor

consulta, fichero_cache, token = sys.argv[1], sys.argv[2], sys.argv[3]

def pet(url, cabeceras=None):
    req = urllib.request.Request(url, headers=cabeceras or {})
    with urllib.request.urlopen(req, timeout=25) as r:
        return json.loads(r.read().decode())

cache = {}
try:
    with open(fichero_cache, encoding="utf-8") as fh:
        cache = json.load(fh)
except Exception:
    pass

headers = {"Accept": "application/vnd.github+json", "User-Agent": "tienda-dsh"}
if token:
    headers["Authorization"] = "Bearer " + token

# ── OpenDesktop (gnome-look, store.kde.org, pling): «od:<tipo> palabras» ──
OD_CATEGORIAS = {"gtk": "135", "iconos": "132", "cursores": "107", "kvantum": "123",
                 "fondos": "295", "gnome": "134", "plasma": "722",
                 "grub": "109", "sddm": "101", "plymouth": "108"}
if consulta.startswith("od:"):
    tipo, _, palabras = consulta[3:].partition(" ")
    cat = OD_CATEGORIAS.get(tipo.strip().lower(), "135")
    url = ("https://api.opendesktop.org/ocs/v1/content/data?format=json&sortmode=high&pagesize=24&categories=" + cat
           + ("&search=" + urllib.parse.quote(palabras.strip()) if palabras.strip() else ""))
    try:
        datos = pet(url, {"User-Agent": "HyprBazar"})
        items = datos.get("data") or []
    except Exception:
        items = []
    try:
        cache = json.load(open(fichero_cache, encoding="utf-8"))
    except Exception:
        cache = {}
    def texto_plano(h):
        return re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", h or "")).strip()[:300]
    for it in items:
        imgs = [it[k] for k in sorted(it) if k.startswith("previewpic") and it.get(k)]
        if not imgs and it.get("smallpreviewpic1"):
            imgs = [it["smallpreviewpic1"]]
        desc = texto_plano(it.get("description") or it.get("summary"))
        print(json.dumps({
            "repo": "od:" + str(it.get("id")),
            "nombre": it.get("name") or "",
            "estrellas": int(float(it.get("score") or 0)),
            "descripcion": desc,
            "descripcion_es": cache.get(desc, desc),
            "avatar": it.get("smallpreviewpic1") or "",
            "url": it.get("detailpage") or "https://www.opendesktop.org",
            "banner": imgs[0] if imgs else "",
            "imagen": imgs[0] if imgs else "",
            "capturas": imgs,
            "temas": [it.get("typename") or "OpenDesktop"],
            "lenguaje": "OpenDesktop",
            "categoria": tipo,
            "actualizado": (it.get("changed") or "")[:10],
        }, ensure_ascii=False))
    sys.exit(0)

q = urllib.parse.quote(consulta)
datos = pet("https://api.github.com/search/repositories?q=" + q + "&sort=stars&order=desc&per_page=24", headers)
items = datos.get("items", [])
# Primero lo que es de Hyprland; los temas de otros escritorios (BSPWM, SDDM...) al final.
def _es_hypr(it):
    txt = " ".join([it.get("full_name") or "", it.get("description") or "", " ".join(it.get("topics") or [])]).lower()
    return "hypr" in txt
# sin dar prioridad a Hyprland: se busca de todo y se ordena por estrellas

def traducir(texto):
    if not texto:
        return ""
    if texto in cache:
        return cache[texto]
    url = ("https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=es&dt=t&q="
           + urllib.parse.quote(texto))
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            d = json.loads(r.read().decode())
        salida = "".join(p[0] for p in (d[0] or []) if p and p[0])
    except Exception:
        salida = ""
    if salida:
        cache[texto] = salida
    return salida

def capturas(repo):
    """Imágenes y vídeos que enseña el README del repo (sin los escudos)."""
    import re
    try:
        url = f"https://raw.githubusercontent.com/{repo}/HEAD/README.md"
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "hyprbazar"}), timeout=15) as r:
            texto = r.read().decode("utf-8", "replace")
    except Exception:
        return []

    candidatas = (re.findall(r"!\[[^\]]*\]\(([^)\s]+)", texto)
                 + re.findall(r"<img[^>]+src=[\"']([^\"']+)", texto)
                 + re.findall(r"\[!\[[^\]]*\]\(([^)]+)\)\]", texto)
                 + re.findall(r"<video[^>]+src=[\"']([^\"']+)", texto))

    salida = []
    for c in candidatas:
        bajo = c.lower()
        if any(x in bajo for x in ("shields.io", "badge", "badgen", "workflow",
                                   "travis", "codecov", "star-history")):
            continue
        if bajo.startswith("http"):
            final = c
        elif c.startswith("/"):
            final = "https://raw.githubusercontent.com" + c
        else:
            final = f"https://raw.githubusercontent.com/{repo}/HEAD/{c.lstrip('./')}"
        if final not in salida:
            salida.append(final)
    return salida[:10]


textos = [i.get("description") or "" for i in items]
with ThreadPoolExecutor(max_workers=6) as ex:
    imagenes = list(ex.map(capturas, [i["full_name"] for i in items]))
with ThreadPoolExecutor(max_workers=6) as ex:
    traducciones = list(ex.map(traducir, textos))

try:
    with open(fichero_cache, "w", encoding="utf-8") as fh:
        json.dump(cache, fh, ensure_ascii=False)
except Exception:
    pass

for item, es, imgs in zip(items, traducciones, imagenes):
    print(json.dumps({
        "repo": item["full_name"],
        "nombre": item["name"],
        "estrellas": item["stargazers_count"],
        "descripcion": item.get("description") or "",
        "descripcion_es": es,
        "avatar": item["owner"]["avatar_url"],
        "url": item["html_url"],
        "banner": (imgs[0] if imgs else ""),
        "imagen": (imgs[0] if imgs else ""),
        "capturas": imgs,
        "temas": item.get("topics") or [],
        "lenguaje": item.get("language") or "",
        "actualizado": (item.get("pushed_at") or "")[:10],
    }, ensure_ascii=False))
PYEOF
}

# ───────────────────────── instalar ─────────────────────────────────────────
# Copia los temas GTK / iconos / cursores / Kvantum que haya dentro de una carpeta.
# Usa las variables «sistema» y «tipos» de quien la llama.
copiar_temas_sistema() {
    local raiz="$1" nombre_base="${2:-${repo##*/}}" d nombre
    local TEMAS_DIR="$HOME/.local/share/themes" ICONOS_DIR="$HOME/.local/share/icons" KV_DIR="$HOME/.config/Kvantum"
    # GTK: carpetas con gtk-3.0/gtk.css o gtk-4.0/gtk.css (no los temas de atajos ni carpetas de configuración)
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        case "$(basename "$d")" in config|.config|home|dotfiles) continue ;; esac
        [ -f "$d/gtk-3.0/gtk.css" ] || [ -f "$d/gtk-4.0/gtk.css" ] || [ -f "$d/gtk-3.0/gtk-dark.css" ] || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$TEMAS_DIR"; rm -rf "${TEMAS_DIR:?}/$nombre"
        cp -r "$d" "$TEMAS_DIR/$nombre" && rm -rf "$TEMAS_DIR/$nombre/.git" && { sistema=$((sistema + 1)); tipos+=(gtk); }
    done < <(find "$raiz" -type d \( -name gtk-3.0 -o -name gtk-4.0 \) -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    # cursores: carpetas con cursors/ y su index.theme
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        [ -f "$d/index.theme" ] || [ "$(find "$d/cursors" -maxdepth 1 -type f -o -type l | head -1)" ] || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$ICONOS_DIR"; rm -rf "${ICONOS_DIR:?}/$nombre"
        cp -r "$d" "$ICONOS_DIR/$nombre" && rm -rf "$ICONOS_DIR/$nombre/.git" && { sistema=$((sistema + 1)); tipos+=(cursor); }
    done < <(find "$raiz" -type d -name cursors -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    # iconos: index.theme con «Directories=» (un tema de iconos de verdad) y sin cursores
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        [ -d "$d/cursors" ] && continue
        [ "$(basename "$d")" = default ] && continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$ICONOS_DIR"; rm -rf "${ICONOS_DIR:?}/$nombre"
        cp -r "$d" "$ICONOS_DIR/$nombre" && rm -rf "$ICONOS_DIR/$nombre/.git" && { sistema=$((sistema + 1)); tipos+=(iconos); }
    done < <(grep -rl --include=index.theme '^Directories=' "$raiz" 2>/dev/null | grep -v '/.git/' | xargs -r -n1 dirname | sort -u)
    # GRUB (theme.txt), SDDM (metadata.desktop) y Plymouth (*.plymouth): a la carpeta de espera
    local STAGE="${XDG_DATA_HOME:-$HOME/.local/share}/hyprbazar/sistema"
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        # varias versiones con la misma carpeta (1080p, 2k, 4k…) en esta misma instalación: nombre del archivo
        if [ -e "$STAGE/grub/$nombre" ] && [ -n "${MARCA_INSTALACION:-}" ] && [ "$STAGE/grub/$nombre" -nt "$MARCA_INSTALACION" ]; then
            nombre="$nombre_base"
        fi
        mk "$STAGE/grub"; rm -rf "${STAGE:?}/grub/$nombre"
        cp -r "$d" "$STAGE/grub/$nombre" && { sistema=$((sistema + 1)); tipos+=(grub); }
    done < <(find "$raiz" -name theme.txt -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        ls "$d"/*.qml >/dev/null 2>&1 || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$STAGE/sddm"; rm -rf "${STAGE:?}/sddm/$nombre"
        cp -r "$d" "$STAGE/sddm/$nombre" && { sistema=$((sistema + 1)); tipos+=(sddm); }
    done < <(find "$raiz" -name metadata.desktop -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$STAGE/plymouth"; rm -rf "${STAGE:?}/plymouth/$nombre"
        cp -r "$d" "$STAGE/plymouth/$nombre" && { sistema=$((sistema + 1)); tipos+=(plymouth); }
    done < <(find "$raiz" -name '*.plymouth' -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    # Kvantum: carpetas con *.kvconfig
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nombre="$(basename "$d")"; [ "$d" = "$raiz" ] && nombre="$nombre_base"
        mk "$KV_DIR"; rm -rf "${KV_DIR:?}/$nombre"
        cp -r "$d" "$KV_DIR/$nombre" && rm -rf "$KV_DIR/$nombre/.git" && { sistema=$((sistema + 1)); tipos+=(kvantum); }
    done < <(find "$raiz" -name '*.kvconfig' -not -path "*/.git/*" -exec dirname {} \; 2>/dev/null | sort -u)
    return 0
}

# Baja los paquetes ya montados de la última «Release» (tar/zip) y copia sus temas.
descargar_releases() {
    local repo="$1" tmp url n=0
    MARCA_INSTALACION="$(mktemp)"; sleep 1
    tmp="$(mktemp -d)"
    while IFS=$'\t' read -r url tam; do
        [ -n "$url" ] || continue
        [ "${tam:-0}" -lt 209715200 ] || continue        # cada archivo < 200 MB
        n=$((n + 1)); [ "$n" -le 12 ] || break           # como mucho 12 archivos
        log "bajando $(basename "$url")…"
        local f="$tmp/$(basename "$url")" dir="$tmp/x$n"
        curl -sSL -m 600 -o "$f" "$url" || continue
        mk "$dir"
        case "$f" in
            *.zip) unzip -q -o "$f" -d "$dir" 2>/dev/null ;;
            *) tar -xf "$f" -C "$dir" 2>/dev/null ;;
        esac
        # nombre del tema = nombre del archivo sin extensión (Nordic-darker.tar.xz → Nordic-darker)
        local base_arch; base_arch="$(basename "$url")"; base_arch="${base_arch%%.tar.*}"; base_arch="${base_arch%.tgz}"; base_arch="${base_arch%.zip}"
        copiar_temas_sistema "$dir" "$base_arch"
    done < <(gh "$API/repos/$repo/releases/latest" \
             | jq -r '.assets[]? | select(.name | test("\\.(tar\\.(xz|gz|bz2|zst)|tgz|zip)$")) | "\(.browser_download_url)\t\(.size)"' 2>/dev/null)
    rm -rf "$tmp"
}

# Como administrador: sudo en una terminal; si no hay terminal, abre una para pedir la contraseña.
como_root() {
    if [ -t 0 ]; then sudo "$@"; return; fi
    local term; term="$(command -v kitty || command -v alacritty || command -v foot || true)"
    [ -n "$term" ] || { log "ejecuta en una terminal: sudo $*"; return 1; }
    "$term" -e sh -c 'echo "HyprBazar necesita tu contraseña:"; echo "  $*"; "$@"; s=$?; echo; read -r -p "Pulsa Intro para cerrar " _; exit $s' sh sudo "$@"
}

# Algunos temas se instalan mejor como paquete (hay que compilarlos o son enormes):
# se busca un paquete con el nombre del repo en los oficiales de Arch y en AUR.
instalar_como_paquete() {
    local base cand ayudante
    base="$(printf '%s' "${repo##*/}" | tr 'A-Z_' 'a-z-')"
    ayudante="$(command -v paru || command -v yay || true)"
    for cand in "$base" "${base%-theme}-theme" "$base-git" "kvantum-theme-$base" "kvantum-theme-$base-git" "${base%-cursors}-cursors"; do
        if pacman -Qq "$cand" >/dev/null 2>&1; then log "ya tienes el paquete $cand"; sistema=$((sistema + 1)); return 0; fi
        if pacman -Si "$cand" >/dev/null 2>&1; then
            if [ "${SIN_DEPS:-0}" = "1" ]; then log "se instalaría el paquete oficial $cand"; sistema=$((sistema + 1)); return 0; fi
            log "instalando el paquete oficial $cand…"
            como_root pacman -S --needed --noconfirm "$cand" && { sistema=$((sistema + 1)); return 0; }
        elif [ -n "$ayudante" ] && "$ayudante" -Si --aur "$cand" >/dev/null 2>&1; then
            if [ "${SIN_DEPS:-0}" = "1" ]; then log "se instalaría el paquete de AUR $cand"; sistema=$((sistema + 1)); return 0; fi
            log "instalando $cand desde AUR…"
            if [ -t 0 ]; then "$ayudante" -S --needed --noconfirm "$cand"
            else local term; term="$(command -v kitty || command -v alacritty || command -v foot || true)"
                 [ -n "$term" ] && "$term" -e sh -c '"$@"; read -r -p "Pulsa Intro para cerrar " _' sh "$ayudante" -S --needed --noconfirm "$cand"
            fi && { sistema=$((sistema + 1)); return 0; }
        fi
    done
    return 1
}

# Paletas en otros formatos (p. ej. Catppuccin: M.mauve = 'rgb(cba6f7)' o $mauve = rgb(cba6f7))
paletas_genericas() {
    local raiz="$1" f id dest
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        id="$(basename "${f%.*}")"
        dest="$PALETAS/${slug}--${id}"
        [ -f "$dest/colors.json" ] && continue
        mk "$dest"
        if python3 -I - "$f" "$dest" "$id" "$repo" <<'PYGEN'
import json, re, sys
f, dest, ident, repo = sys.argv[1:5]
v = {}
for linea in open(f, encoding="utf-8", errors="ignore"):
    m = re.search(r"[$.]?([A-Za-z][A-Za-z0-9_]*)\s*=\s*['\"]?(?:rgba?\()?#?([0-9a-fA-F]{6})", linea)
    if m and not m.group(1).endswith("Alpha"):
        v.setdefault(m.group(1).lower(), "#" + m.group(2).lower())
def c(*k):
    return next((v[x] for x in k if x in v), None)
bg, fg = c("base", "background", "bg"), c("text", "foreground", "fg")
if not bg or not fg or len(v) < 8:
    sys.exit(1)
colores = {
    "bg": bg, "bg_alt": c("mantle", "crust", "black") or bg, "surface": c("surface0", "surface", "black") or bg,
    "surface2": c("surface1", "surface2", "overlay0") or bg, "fg": fg, "fg_dim": c("subtext0", "subtext1", "comment") or fg,
    "accent": c("mauve", "blue", "accent", "purple") or fg, "accent_alt": c("lavender", "sapphire", "cyan") or fg,
    "red": c("red") or fg, "orange": c("peach", "orange") or fg, "yellow": c("yellow") or fg, "green": c("green") or fg,
    "teal": c("teal", "cyan") or fg, "blue": c("blue") or fg, "sky": c("sky", "cyan") or fg, "mauve": c("mauve", "purple") or fg,
    "pink": c("pink", "magenta") or fg, "lavender": c("lavender") or fg,
    "border_active": c("mauve", "blue", "accent") or fg, "border_inactive": c("surface1", "surface0") or bg,
    "shadow": c("crust", "mantle") or bg, "overlay": c("overlay0", "surface2") or bg,
}
nombre = re.sub(r"[-_]+", " ", ident).strip().title()
json.dump(colores, open(f"{dest}/colors.json", "w"), indent=2)
json.dump({"name": nombre, "author": repo.split("/")[0]}, open(f"{dest}/theme.json", "w"), indent=2)
open(f"{dest}/repo.txt", "w").write(repo + "\n")
PYGEN
        then paletas=$((paletas + 1)); else rm -rf "$dest"; fi
    done < <(find "$raiz" \( -path '*/themes/*.lua' -o -path '*/themes/*.conf' \) -not -path "*/.git/*" 2>/dev/null)
}

# Instala un contenido de OpenDesktop (od:<id>): baja sus archivos y copia temas o fondos.
instalar_od() {
    local id="${1#od:}" info tmp n=0 nombre sistema=0 fondos=0 tipos=()
    MARCA_INSTALACION="$(mktemp)"; sleep 1
    info="$(curl -sS -m 30 -H 'User-Agent: HyprBazar' "https://api.opendesktop.org/ocs/v1/content/data/$id?format=json")" || { log "no pude leer od:$id"; return 1; }
    nombre="$(printf '%s' "$info" | jq -r '.data[0].name // empty' | tr '/' '-')"
    [ -n "$nombre" ] || { log "no existe od:$id"; return 1; }
    local repo="$nombre" slug="od-$id"
    tmp="$(mktemp -d)"
    while IFS=$'\t' read -r url archivo tam; do
        [ -n "$url" ] || continue
        [ "${tam:-0}" -lt 204800 ] || continue          # < 200 MB (el tamaño viene en KB)
        n=$((n + 1)); [ "$n" -le 8 ] || break
        log "bajando $archivo…"
        local f="$tmp/$archivo" dir="$tmp/x$n" base="${archivo%%.tar.*}"; base="${base%.zip}"; base="${base%.tgz}"
        curl -sSL -m 600 -o "$f" "$url" || continue
        case "$archivo" in
            *.png|*.jpg|*.jpeg|*.webp|*.gif)
                mk "$FONDOS/opendesktop/$nombre"; cp -f "$f" "$FONDOS/opendesktop/$nombre/" && fondos=$((fondos + 1)) ;;
            *.zip) mk "$dir"; unzip -q -o "$f" -d "$dir" 2>/dev/null; copiar_temas_sistema "$dir" "$base" ;;
            *.tar*|*.tgz) mk "$dir"; tar -xf "$f" -C "$dir" 2>/dev/null; copiar_temas_sistema "$dir" "$base" ;;
        esac
    done < <(printf '%s' "$info" | python3 -I -c '
import json, sys
d = json.load(sys.stdin)["data"][0]
for k in sorted(d):
    if k.startswith("downloadlink") and d[k]:
        i = k[len("downloadlink"):]
        print(d[k], d.get("downloadname" + i) or ("archivo" + i), d.get("downloadsize" + i) or 0, sep="\t")
')
    rm -rf "$tmp"
    mk "$DATOS/$slug"; printf 'od:%s\t%s\n' "$id" "$nombre" > "$DATOS/$slug/opendesktop.txt"
    if [ "${#tipos[@]}" -gt 0 ] && [ "${SIN_DEPS:-0}" != "1" ]; then
        local sis; sis="$(command -v hyprbazar-sistema || printf '%s' "$(dirname "$(readlink -f "$0")")/hyprbazar-sistema")"
        mapfile -t tipos < <(printf '%s\n' "${tipos[@]}" | sort -u)
        [ -x "$sis" ] && "$sis" instalar-deps "${tipos[@]}"
    fi
    printf 'instalado od:%s: 0 paletas, %s fondos, %s temas del sistema\n' "$id" "$fondos" "$sistema"
}

instalar() {
    local repo="$1" slug destino
    slug="$(printf '%s' "$repo" | tr '/' '-')"
    destino="$DATOS/$slug"
    mk "$DATOS"

    if [ -d "$destino/.git" ]; then
        log "actualizando $repo…"
        git -C "$destino" fetch --depth 1 origin >/dev/null 2>&1 && \
        git -C "$destino" reset --hard FETCH_HEAD >/dev/null 2>&1
        # repos bajados con una versión anterior: añadir los archivos de colores de los rices
        if [ "$(git -C "$destino" config --get core.sparseCheckout 2>/dev/null)" = "true" ]; then
            git -C "$destino" sparse-checkout add '**/theme-config.bash' '**/themes/*.lua' '**/themes/*.conf' >/dev/null 2>&1 || true
        fi
    else
        log "descargando $repo…"
        rm -rf "$destino"
        git clone --depth 1 --filter=blob:none --sparse \
            "https://github.com/$repo.git" "$destino" >/dev/null 2>&1 || {
            log "no pude descargar $repo"; return 1; }
        # solo lo que sirve: paletas, fondos y capturas
        local patrones=(
            '**/colors.json' '**/theme.json' '**/theme-config.bash' '**/themes/*.lua' '**/themes/*.conf'
            '**/wallpapers/**' '**/Wallpapers/**' '**/wallpaper/**' '**/Wallpaper/**'
            '**/backgrounds/**' '**/Backgrounds/**' '**/walls/**' '**/Walls/**'
            'Screenshots/**' 'screenshots/**' '**/Screenshots/**'
        )
        if [ "${SOLO_PALETAS:-0}" = "1" ]; then
            patrones=('**/colors.json' '**/theme.json')
        fi
        git -C "$destino" sparse-checkout set --no-cone "${patrones[@]}" >/dev/null 2>&1 || true
    fi

    local paletas=0 fondos=0
    # ── paletas ──
    while IFS= read -r colors; do
        [ -n "$colors" ] || continue
        local dir id
        dir="$(dirname "$colors")"
        id="$(basename "$dir")"
        # si ya tenemos ese tema (descargado con "paleta descargar"), no duplicar
        [ -d "$PALETAS/$id" ] && continue
        # nombre único: repo + tema
        local destino_pal="$PALETAS/${slug}--${id}"
        mk "$destino_pal"
        cp -f "$colors" "$destino_pal/colors.json" 2>/dev/null || continue
        [ -f "$dir/theme.json" ] && cp -f "$dir/theme.json" "$destino_pal/theme.json" 2>/dev/null
        printf '%s\n' "$repo" > "$destino_pal/repo.txt"
        paletas=$((paletas + 1))
    done < <(find "$destino" -name colors.json -not -path "*/.git/*" 2>/dev/null)

    # ── fondos ──
    local carpeta="$FONDOS/$slug"
    mk "$carpeta"
    while IFS= read -r img; do
        [ -n "$img" ] || continue
        cp -f "$img" "$carpeta/" 2>/dev/null && fondos=$((fondos + 1))
    done < <(find "$destino" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
             -not -path "*/.git/*" -not -path "*/Screenshots/*" -not -path "*/screenshots/*" 2>/dev/null \
             | grep -iE '/(wallpapers?|backgrounds?|walls?|fondos)/')

    # ── plan B: si no apareció nada, bajar el repo entero (si no es enorme) ──
    if [ "$paletas" -eq 0 ] && [ "$fondos" -eq 0 ] && [ "${SOLO_PALETAS:-0}" != "1" ]; then
        local tam
        tam="$(gh "$API/repos/$repo" | jq -r '.size // 0')"
        if [ "${tam:-0}" -lt 80000 ]; then
            log "estructura distinta; descargando el repo completo…"
            git -C "$destino" sparse-checkout disable >/dev/null 2>&1 || true
            while IFS= read -r colors; do
                [ -n "$colors" ] || continue
                local id2 dest2
                id2="$(basename "$(dirname "$colors")")"
                dest2="$PALETAS/${slug}--${id2}"
                mk "$dest2"
                cp -f "$colors" "$dest2/colors.json" 2>/dev/null && {
                    [ -f "$(dirname "$colors")/theme.json" ] && cp -f "$(dirname "$colors")/theme.json" "$dest2/theme.json" 2>/dev/null
                    printf '%s\n' "$repo" > "$dest2/repo.txt"
                    paletas=$((paletas + 1))
                }
            done < <(find "$destino" -name colors.json -not -path "*/.git/*" 2>/dev/null)
            while IFS= read -r img; do
                [ -n "$img" ] || continue
                cp -f "$img" "$carpeta/" 2>/dev/null && fondos=$((fondos + 1))
            done < <(find "$destino" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -not -path "*/.git/*" -not -path "*/Screenshots/*" 2>/dev/null)
        fi
    fi

    # ── paletas en otros formatos (Catppuccin .lua/.conf…) ──
    paletas_genericas "$destino"

    # ── rices (p. ej. gh0stzk): theme-config.bash con colores → tema de color ──
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        local rdir rid rdest
        rdir="$(dirname "$cfg")"; rid="$(basename "$rdir")"
        rdest="$PALETAS/${slug}--${rid}"
        [ -f "$rdest/colors.json" ] && continue
        mk "$rdest"
        if python3 -I - "$cfg" "$rdest" "$rid" "$repo" <<'PYRICE'
import json, re, sys
cfg, dest, rid, repo = sys.argv[1:5]
v = {}
for linea in open(cfg, encoding="utf-8", errors="ignore"):
    m = re.match(r'\s*([A-Za-z_]+)="(#[0-9A-Fa-f]{6,8})"', linea)
    if m:
        v[m.group(1)] = "#" + m.group(2)[-6:] if len(m.group(2)) == 9 else m.group(2)
if "bg" not in v or "fg" not in v:
    sys.exit(1)
c = lambda *k: next((v[x] for x in k if x in v), v["fg"])
colores = {
    "bg": v["bg"], "bg_alt": c("black", "bg"), "surface": c("blackb", "black"), "surface2": c("grey", "blackb"),
    "fg": v["fg"], "fg_dim": c("white", "fg"),
    "accent": c("blue", "cyan"), "accent_alt": c("magenta", "cyan"),
    "red": c("red"), "orange": c("orange", "yellow"), "yellow": c("yellow"), "green": c("green"),
    "teal": c("cyan"), "blue": c("blue"), "sky": c("cyanb", "cyan"), "mauve": c("magenta"),
    "pink": c("pink", "magenta"), "lavender": c("indigo", "blueb", "blue"),
    "border_active": c("blue", "magenta"), "border_inactive": c("blackb", "black"),
    "shadow": c("black", "bg"), "overlay": c("blackb", "grey"),
}
json.dump(colores, open(f"{dest}/colors.json", "w"), indent=2)
json.dump({"name": rid.capitalize(), "author": repo.split("/")[0]}, open(f"{dest}/theme.json", "w"), indent=2)
open(f"{dest}/repo.txt", "w").write(repo + "\n")
PYRICE
        then
            paletas=$((paletas + 1))
            # sus fondos, en una carpeta por rice
            if [ -d "$rdir/walls" ]; then
                mk "$carpeta/$rid"
                cp -f "$rdir"/walls/* "$carpeta/$rid/" 2>/dev/null
            fi
        else
            rm -rf "$rdest"
        fi
    done < <(find "$destino" -name theme-config.bash -not -path "*/.git/*" 2>/dev/null)

    # ── temas del sistema: GTK, iconos, cursores y Kvantum (no solo Hyprland) ──
    local sistema=0 tipos=()
    if [ "${SOLO_PALETAS:-0}" != "1" ]; then
        # primero las variantes ya montadas que el autor publica en «Releases»
        descargar_releases "$repo"
        # (se guarda en una variable: con «| grep -q» y pipefail, en repos grandes salía «no»)
        local arbol
        arbol="$(gh "$API/repos/$repo/git/trees/HEAD?recursive=1" | jq -r '.tree[]?.path' 2>/dev/null)"
        if [ "$sistema" -eq 0 ] && grep -qE '(^|/)(gtk-[34]\.0|cursors)/|(^|/)index\.theme$|\.kvconfig$' <<<"$arbol"; then
            local tam2
            tam2="$(gh "$API/repos/$repo" | jq -r '.size // 0')"
            if [ "${tam2:-0}" -lt 300000 ]; then   # < ~300 MB
                log "tiene temas del sistema; descargando el repo completo…"
                git -C "$destino" sparse-checkout disable >/dev/null 2>&1 || true
                copiar_temas_sistema "$destino"
            else
                log "el repo es demasiado grande para bajar sus temas del sistema (${tam2} KB)"
            fi
        fi
        # y otros solo se pueden instalar como paquete (Orchis, Papirus, Qogir…)
        # o el repo es de iconos / temas y no ha salido ese tipo (p. ej. Qogir-icon-theme
        # solo trae cursores montados; sus iconos hay que compilarlos → paquete)
        local nombre_repo; nombre_repo="$(printf '%s' "${repo##*/}" | tr 'A-Z' 'a-z')"
        local falta_tipo=0
        case "$nombre_repo" in *icon*) [[ " ${tipos[*]} " == *" iconos "* ]] || falta_tipo=1 ;; esac
        case "$nombre_repo" in *gtk*|*-theme) [[ " ${tipos[*]} " == *" gtk "* || " ${tipos[*]} " == *" iconos "* ]] || falta_tipo=1 ;; esac
        if { [ "$sistema" -eq 0 ] && [ "$paletas" -eq 0 ]; } || [ "$falta_tipo" -eq 1 ]; then
            instalar_como_paquete || true
        fi
    fi

    # ── dependencias para que funcione al 100 % (solo paquetes oficiales de Arch) ──
    if [ "${#tipos[@]}" -gt 0 ]; then
        local sis
        sis="$(command -v hyprbazar-sistema || printf '%s' "$(dirname "$(readlink -f "$0")")/hyprbazar-sistema")"
        mapfile -t tipos < <(printf '%s\n' "${tipos[@]}" | sort -u)
        if [ -x "$sis" ] && [ "${SIN_DEPS:-0}" != "1" ]; then
            "$sis" instalar-deps "${tipos[@]}" || log "no se instalaron las dependencias (puedes hacerlo desde «Temas del sistema»)"
        fi
    fi

    printf 'instalado %s: %s paletas, %s fondos, %s temas del sistema\n' "$repo" "$paletas" "$fondos" "$sistema"
}

instalados() {
    local d
    for d in "$DATOS"/*/; do
        if [ -d "$d/.git" ]; then
            printf '%s\n' "$(basename "$d")"
        elif [ -f "$d/opendesktop.txt" ]; then      # instalados desde OpenDesktop
            printf '%s\n' "$(basename "$d")"
        fi
    done
}

case "${1:-}" in
    buscar)    buscar_simple "${2:-hyprland dotfiles}" ;;
    instalar)
        shift
        while [ $# -gt 0 ] && [ "${1#--}" != "$1" ]; do
            [ "$1" = "--solo-paletas" ] && SOLO_PALETAS=1
            shift
        done
        case "${1:-}" in
            od:*) instalar_od "$1" ;;
            "")   log "uso: tienda instalar [--solo-paletas] owner/repo | od:<id>"; exit 1 ;;
            *)    instalar "$1" ;;
        esac ;;
    instalados) instalados ;;
    *) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
