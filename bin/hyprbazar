DMS_COLORES = Path.home() / ".cache" / "DankMaterialShell" / "dms-colors.json"
_PALETA_POR_DEFECTO = {
    "surface": "#131318", "on_surface": "#e5e1e9", "on_surface_variant": "#c8c5d0",
    "surface_container_low": "#1c1b20", "surface_container": "#201f25",
