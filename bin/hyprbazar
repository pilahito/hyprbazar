CACHE_TIENDA = Path.home() / ".cache" / "tienda"


def _cargar_css(css):
    """Aplica una hoja de estilos a toda la app (una sola vez por texto)."""
    global _CSS_APLICADOS
    try:
        aplicados = _CSS_APLICADOS
    except NameError:
        aplicados = _CSS_APLICADOS = set()
    if css in aplicados:
        return
    proveedor = Gtk.CssProvider()
    proveedor.load_from_data(css.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), proveedor, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )
    aplicados.add(css)
TIENDA = _local_bin("hyprbazar-tienda", "tienda")


# ────────────────────────────── datos ───────────────────────────────────────
def leer_temas():
    """Lista de temas en el MISMO orden que usa cambiar-tema.sh (1..N)."""
    temas = []
    if not LISTA.exists():
        return temas
    for linea in LISTA.read_text(encoding="utf-8", errors="replace").splitlines():
        s = linea.strip()
        if not s or s.startswith("#"):
            continue
        partes = s.split("|")
        while len(partes) < 3:
            partes.append("")
        nombre, fondo, iconos = (p.strip() for p in partes[:3])
        temas.append({"n": len(temas) + 1, "nombre": nombre, "fondo": fondo, "iconos": iconos})
    return temas


def tema_actual():
    try:
        return int(ACTUAL.read_text(encoding="utf-8").strip())
    except Exception:
        return 0


def miniatura(fondo: str) -> Path | None:
    """Genera (o reutiliza) la miniatura del fondo. Devuelve la ruta o None."""
    if not fondo or not Path(fondo).exists():
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    try:
        st = os.stat(fondo)
    except OSError:
        return None
    clave = hashlib.sha1(f"{fondo}|{st.st_mtime_ns}|{st.st_size}".encode()).hexdigest()[:16]
    destino = CACHE / f"{clave}.png"
    if destino.exists():
        return destino

    magick = shutil.which("magick") or shutil.which("convert")
    if magick:
        cmd = [
            magick, f"{fondo}[0]",
            "-thumbnail", f"{THUMB_W}x{THUMB_H}^",
            "-gravity", "center", "-extent", f"{THUMB_W}x{THUMB_H}",
            "-strip", str(destino),
        ]
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=30)
            if destino.exists():
                return destino
        except Exception:
            pass
    # plan B: cargar con GdkPixbuf y escalar (sirve para png/jpg/webp)
    try:
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf

        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(fondo, THUMB_W, THUMB_H, False)
        pb.savev(str(destino), "png", [], [])
        return destino if destino.exists() else None
    except Exception:
        return None



# ─────────────────────── traducción de los nombres ──────────────────────────
# Los temas descargados o añadidos suelen venir con nombre en inglés. Aquí se
# traducen al español para mostrarlos, guardando el resultado en caché para no
# repetir la consulta cada vez que se abre la ventana.
def _cache_trad():
    try:
        return json.loads(CACHE_TRAD.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _guardar_cache_trad(datos):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        CACHE_TRAD.write_text(
            json.dumps(datos, ensure_ascii=False, indent=1), encoding="utf-8"
        )
    except Exception:
        pass


def traducir_nombre(texto: str):
    """Devuelve (traducción, idioma_detectado). "" si no se pudo traducir."""
    if not texto.strip():
        return "", ""
    cache = _cache_trad()
    if texto in cache:
        return cache[texto]["es"], cache[texto]["de"]
    params = urllib.parse.urlencode(
        {"client": "gtx", "sl": "auto", "tl": "es", "dt": "t", "q": texto[:400]}
    )
    url = f"https://translate.googleapis.com/translate_a/single?{params}"
    try:
        r = subprocess.run(
            ["curl", "-sS", "--max-time", "12", url],
            capture_output=True, text=True, timeout=15,
        )
        datos = json.loads(r.stdout)
        salida = "".join(p[0] for p in (datos[0] or []) if p and p[0])
        idioma = datos[2] if len(datos) > 2 else ""
    except Exception:
        return "", ""
    if not salida:
        return "", ""
    cache[texto] = {"es": salida, "de": idioma}
    _guardar_cache_trad(cache)
    return salida, idioma


# ────────────────────────────── ventana ─────────────────────────────────────
class Ventana(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="HyprBazar")
        self.set_icon_name("hyprbazar")
        self.set_default_size(1120, 780)
        self.temas = []
        self.botones = {}
        self.etiquetas = {}
        self.traduciendo = False
        self.modo = "temas"          # "temas" o "biblioteca"
        self._miniaturas = []        # (Gtk.Picture, ruta) pendientes de miniatura
        self.fondos_biblioteca = []

        _cargar_css(CSS_APP)

        cabecera = Gtk.HeaderBar()
        self.pila = Gtk.Stack()
        self.pila.set_transition_type(Gtk.StackTransitionType.NONE)
        selector = Gtk.StackSwitcher()
        selector.set_stack(self.pila)
        cabecera.set_title_widget(selector)
        self.set_titlebar(cabecera)

        # ── barra de herramientas: buscar + acciones ──
        barra = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        barra.add_css_class("page-toolbar")

        self.busqueda = Gtk.SearchEntry(placeholder_text="Buscar fondo…")
        self.busqueda.set_hexpand(True)
        self.busqueda.connect("search-changed", lambda *_: self.filtrar())
        barra.append(self.busqueda)

        def boton(texto, tooltip, accion, clase=None):
            b = Gtk.Button(label=texto)
            b.set_tooltip_text(tooltip)
            b.connect("clicked", lambda *_: accion())
            if clase:
                b.add_css_class(clase)
            barra.append(b)
            return b

        self.btn_biblioteca = boton(
            "Biblioteca", "Ver todos los fondos de tu carpeta de fondos", self.on_biblioteca, "flat")
        self.btn_carpeta = Gtk.Button()
        self.btn_carpeta.set_tooltip_text(
            "Carpeta de fondos que se está usando · pulsa para cambiarla")
        self.btn_carpeta.add_css_class("flat")
        self.btn_carpeta.connect("clicked", lambda *_: self.on_elegir_carpeta())
        barra.append(self.btn_carpeta)
        self.actualizar_btn_carpeta()
        boton("Aleatorio", "Aplica un fondo al azar", self.on_aleatorio, "flat")
        boton("Recargar", "Vuelve a leer la lista y regenera las miniaturas",
              lambda: self.cargar(), "flat")
        boton("Añadir…", "Añade un fondo que ya tengas en el equipo", self.on_anadir, "flat")
        boton("Descargar", "Descarga fondos nuevos y los añade a la lista",
              self.on_descargar, "suggested-action")

        # ── pie: cuántos hay y cuál está puesto ──
        self.estado = Gtk.Label(label="")
        self.estado.set_xalign(0)
        self.estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.estado)

        self.flujo = Gtk.FlowBox()
        self.flujo.set_valign(Gtk.Align.START)
        self.flujo.set_homogeneous(True)
        self.flujo.set_max_children_per_line(3)
        self.flujo.set_min_children_per_line(2)
        self.flujo.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flujo.set_margin_top(6)
        self.flujo.set_margin_bottom(12)
        self.flujo.set_margin_start(14)
        self.flujo.set_margin_end(14)
        self.flujo.set_row_spacing(10)
        self.flujo.set_column_spacing(10)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.flujo)

        raiz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        raiz.append(barra)
        raiz.append(scroll)
        raiz.append(pie)
        self.pila.add_titled(raiz, "fondos", "Fondos de pantalla")

        self.pagina_paletas = PaletasPage(self)
        self.pila.add_titled(self.pagina_paletas, "paletas", "Temas de color")

        self.pagina_tienda = TiendaPage(self)
        self.pila.add_titled(self.pagina_tienda, "tienda", "Tienda")

        self.pagina_complementos = ComplementosPage(self)
        self.pila.add_titled(self.pagina_complementos, "complementos", "Complementos")

        self.pagina_sonido = SonidoPage(self)
        self.pila.add_titled(self.pagina_sonido, "sonido", "Sonido")
        self.pila.connect("notify::visible-child", self.on_cambio_pagina)

        # F5 / Ctrl+R: recargar la pestaña que esté abierta
        atajo = Gtk.ShortcutController()
        for tecla in ("F5", "<Control>r"):
            atajo.add_shortcut(Gtk.Shortcut(
                trigger=Gtk.ShortcutTrigger.parse_string(tecla),
                action=Gtk.CallbackAction.new(lambda *_: (self.recargar_pestana(), True)[1])))
        self.add_controller(atajo)

        self.set_child(self.pila)

        # abrir en otra pestaña si se pide (se hace al mapear la ventana)
        def abrir_pestana():
            if os.environ.get("TEMAS_PALETAS") == "1":
                self.pila.set_visible_child_name("paletas")
                self.pagina_paletas.generar_previas()
            if os.environ.get("TEMAS_SONIDO") == "1":
                self.pila.set_visible_child_name("sonido")
            if os.environ.get("TEMAS_COMPLEMENTOS") == "1":
                self.pila.set_visible_child_name("complementos")
            if os.environ.get("TEMAS_INSTALADOS") == "1":
                self.pila.set_visible_child_name("tienda")
                self.pagina_tienda.busqueda.set_text("")
                self.pagina_tienda.buscar("")
            if os.environ.get("TEMAS_TIENDA") == "1":
                self.pila.set_visible_child_name("tienda")
                consulta = os.environ.get("TEMAS_BUSCAR", "").strip()
                if consulta:
                    self.pagina_tienda.busqueda.set_text(consulta)
                    self.pagina_tienda.buscar(consulta)
            return False

        GLib.idle_add(abrir_pestana)

        self.cargar()

    # ── construcción de la lista ────────────────────────────────────────────
    def recargar_pestana(self):
        """Recarga lo que se esté viendo (fondos, tienda, paletas o sonido)."""
        nombre = self.pila.get_visible_child_name()
        if nombre == "tienda":
            self.pagina_tienda.recargar()
        elif nombre == "paletas":
            self.pagina_paletas.cargar()
            self.pagina_paletas.generar_previas()
        elif nombre == "sonido":
            self.pagina_sonido.actualizar_estado()
        self.cargar()

    def on_cambio_pagina(self, *_):
        nombre = self.pila.get_visible_child_name()
        # los botones de fondos solo tienen sentido en su pestaña
        if nombre == "paletas":
            self.pagina_paletas.generar_previas()
        if nombre == "tienda":
            self.pagina_tienda.auto_cargar()

    def cargar(self):
        """Pinta la pestaña según el modo (temas de la lista o biblioteca)."""
        if self.modo == "biblioteca":
            self.cargar_biblioteca()
        else:
            self.cargar_temas()

    CANDIDATAS = (
        Path.home() / "Imágenes" / "Wallpapers",
        Path.home() / "Pictures" / "Wallpapers",
        Path.home() / ".temas" / "wallpapers",
        Path.home() / "HyprLuna" / "Pictures" / "Wallpapers",
        Path.home() / "Imágenes",
        Path.home() / "Pictures",
    )

    def carpeta_biblioteca(self):
        """Carpeta de fondos: la guardada o, si no hay, la que más imágenes tenga."""
        try:
            datos = json.loads(CONFIG_BIBLIOTECA.read_text(encoding="utf-8"))
            ruta = datos.get("carpeta")
            if ruta and Path(ruta).is_dir():
                return Path(ruta)
        except Exception:
            pass
        mejor, maximo = CARPETA_FONDOS, -1
        for candidata in self.CANDIDATAS:
            if not candidata.is_dir():
                continue
            try:
                n = sum(1 for f in candidata.rglob("*")
                        if f.is_file() and f.suffix.lower() in EXTENSIONES)
            except Exception:
                n = 0
            if n > maximo:
                mejor, maximo = candidata, n
        return mejor

    def actualizar_btn_carpeta(self):
        try:
            nombre = self.carpeta_biblioteca().name
        except Exception:
            nombre = "Wallpapers"
        self.btn_carpeta.set_label(f"📁 {nombre}")

    def cargar_biblioteca(self):
        """Rejilla con TODOS los fondos de la carpeta elegida."""
        while (hijo := self.flujo.get_first_child()) is not None:
            self.flujo.remove(hijo)
        self.botones.clear()
        self.etiquetas.clear()

        carpeta = self.carpeta_biblioteca()
        fondos = []
        if carpeta.is_dir():
            try:
                fondos = sorted(
                    (f for f in carpeta.rglob("*")
                     if f.is_file() and f.suffix.lower() in EXTENSIONES),
                    key=lambda f: f.name.lower())
            except Exception:
                fondos = []
        self.fondos_biblioteca = [str(f) for f in fondos]

        if not self.fondos_biblioteca:
            self.estado.set_text(
                f"No hay imágenes en {carpeta}. Usa «Otra carpeta…» para elegir otra.")
            self.btn_biblioteca.set_label("Volver a temas")
            return

        for ruta in self.fondos_biblioteca:
            tarjeta = self.tarjeta_fondo(ruta)
            self.flujo.append(tarjeta)
            self.botones[ruta] = tarjeta

        self.filtrar()
        self.estado.set_text(
            f"{len(self.fondos_biblioteca)} fondos en {carpeta} · pulsa el que quieras poner de fondo")
        self._generar_miniaturas()

    def _generar_miniaturas(self):
        """Genera las miniaturas pendientes en segundo plano, sin bloquear."""
        pendientes = list(self._miniaturas)
        self._miniaturas = []
        if not pendientes:
            return

        def trabajo():
            for imagen, ruta in pendientes:
                try:
                    thumb = miniatura(ruta)
                except Exception:
                    thumb = None
                if thumb:
                    GLib.idle_add(self._poner_miniatura, imagen, thumb)

        threading.Thread(target=trabajo, daemon=True).start()

    def _poner_miniatura(self, imagen, thumb):
        try:
            imagen.set_paintable(Gdk.Texture.new_from_filename(str(thumb)))
        except Exception:
            pass
        return False

    def tarjeta_fondo(self, ruta):
        """Ficha de un fondo de la biblioteca."""
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")

        imagen = Gtk.Picture.new_for_paintable(None)
        imagen.set_content_fit(Gtk.ContentFit.COVER)
        # la miniatura se genera en segundo plano: con 200 fondos, hacerlo aquí
        # congelaba la ventana (la miniatura de cada imagen tarda lo suyo)
        self._miniaturas.append((imagen, ruta))
        imagen.set_can_shrink(True)
        imagen.set_hexpand(True)
        imagen.set_size_request(240, 140)
        marco = Gtk.Frame()
        marco.add_css_class("store-banner")
        marco.set_child(imagen)
        marco.set_overflow(Gtk.Overflow.HIDDEN)
        caja.append(marco)

        nombre = Gtk.Label(label=Path(ruta).stem.replace("_", " "))
        nombre.set_xalign(0)
        nombre.set_ellipsize(3)
        nombre.set_hexpand(True)
        nombre.add_css_class("store-title")
        caja.append(nombre)

        sub = Gtk.Label(label=str(Path(ruta).relative_to(self.carpeta_biblioteca())))
        sub.set_xalign(0)
        sub.set_ellipsize(2)
        sub.add_css_class("store-desc")
        caja.append(sub)

        acciones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        aplicar = Gtk.Button(label="Poner de fondo")
        aplicar.add_css_class("store-instalar")
        aplicar.add_css_class("suggested-action")
        aplicar.connect("clicked", lambda *_, r=ruta: self.aplicar_fondo(r))
        acciones.append(aplicar)

        carpeta = Gtk.Button(label="Carpeta")
        carpeta.add_css_class("flat")
        carpeta.connect("clicked", lambda *_, r=ruta: abrir_carpeta(str(Path(r).parent)))
        acciones.append(carpeta)
        caja.append(acciones)

        caja.set_tooltip_text(ruta)
        return caja

    def aplicar_fondo(self, ruta):
        if not Path(ruta).is_file():
            self.estado.set_text("Ese archivo ya no existe.")
            return
        self.estado.set_text(f"Poniendo {Path(ruta).name} de fondo…")
        self.set_cursor_from_name("wait")

        def trabajo():
            ok = False
            try:
                monitores = subprocess.run(
                    ["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=15
                ).stdout
                nombres = [m["name"] for m in json.loads(monitores or "[]")]
            except Exception:
                nombres = []
            for monitor in nombres:
                if subprocess.run(["dms", "ipc", "call", "wallpaper", "setFor", monitor, ruta],
                                  capture_output=True, timeout=30).returncode == 0:
                    ok = True
            if not ok:
                subprocess.run(["dms", "ipc", "call", "wallpaper", "set", ruta],
                               capture_output=True, timeout=30)
            # DMS no repinta por sí solo: lo hace awww
            try:
                if shutil.which("awww"):
                    subprocess.run(["pgrep", "-x", "awww-daemon"], capture_output=True, timeout=10)
                    subprocess.run(["awww", "img", ruta, "--transition-type", "any",
                                    "--transition-duration", "1"], capture_output=True, timeout=30)
            except Exception:
                pass
            GLib.idle_add(self.fin_aplicar_fondo, ruta)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_aplicar_fondo(self, ruta):
        self.set_cursor_from_name(None)
        self.estado.set_text(f"Fondo puesto: {Path(ruta).name}")
        return False

    def on_biblioteca(self, *_):
        if self.modo == "temas":
            self.modo = "biblioteca"
            self.btn_biblioteca.set_label("Volver a temas")
        else:
            self.modo = "temas"
            self.btn_biblioteca.set_label("Biblioteca")
        self.busqueda.set_text("")
        self.actualizar_btn_carpeta()
        self.cargar()

    def on_elegir_carpeta(self, *_):
        dialogo = Gtk.FileDialog(title="Elige la carpeta de fondos")
        dialogo.set_initial_folder(Gio.File.new_for_path(str(self.carpeta_biblioteca())))

        def hecho(dlg, resultado):
            try:
                f = dlg.select_folder_finish(resultado)
            except Exception:
                return
            if f is None:
                return
            CONFIG_BIBLIOTECA.parent.mkdir(parents=True, exist_ok=True)
            CONFIG_BIBLIOTECA.write_text(
                json.dumps({"carpeta": f.get_path()}, indent=1), encoding="utf-8")
            self.modo = "biblioteca"
            self.btn_biblioteca.set_label("Volver a temas")
            self.actualizar_btn_carpeta()
            self.cargar()

        dialogo.select_folder(self, None, hecho)

    def cargar_temas(self):
        self.temas = leer_temas()
        while (hijo := self.flujo.get_first_child()) is not None:
            self.flujo.remove(hijo)
        self.botones.clear()
        self.etiquetas.clear()

        actual = tema_actual()
        for t in self.temas:
            tarjeta = self.tarjeta(t, actual)
            self.flujo.append(tarjeta)
            self.botones[t["n"]] = tarjeta

        self.filtrar()
        self._generar_miniaturas()
        self.traducir_nombres()
        self.estado.set_text(
            f"{len(self.temas)} fondos · en uso el {actual or '?'} · pulsa uno para aplicarlo"
        )

    def tarjeta(self, t, actual):
        """Misma ficha que en la tienda: imagen, título, datos y botón."""
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")

        # ── imagen ──
        imagen = Gtk.Picture.new_for_paintable(None)
        imagen.set_content_fit(Gtk.ContentFit.COVER)
        self._miniaturas.append((imagen, t["fondo"]))
        imagen.set_can_shrink(True)
        imagen.set_hexpand(True)
        imagen.set_size_request(240, 140)

        marco = Gtk.Frame()
        marco.add_css_class("store-banner")
        marco.set_child(imagen)
        marco.set_overflow(Gtk.Overflow.HIDDEN)
        caja.append(marco)

        # ── título + chip ──
        fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        nombre = Gtk.Label(label=t["nombre"])
        nombre.set_xalign(0)
        nombre.set_ellipsize(3)
        nombre.set_hexpand(True)
        nombre.add_css_class("store-title")
        self.etiquetas[t["n"]] = nombre
        fila.append(nombre)

        if t["n"] == actual:
            chip = Gtk.Label(label="En uso")
            chip.add_css_class("store-badge")
            chip.add_css_class("store-badge-ok")
            fila.append(chip)
        caja.append(fila)

        # ── archivo + iconos ──
        sub = Gtk.Label(label=Path(t["fondo"]).name if t["fondo"] else "sin fondo")
        sub.set_xalign(0)
        sub.set_ellipsize(2)
        sub.add_css_class("store-desc")
        caja.append(sub)

        # ── acciones ──
        acciones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        aplicar = Gtk.Button(label="Aplicar" if t["n"] != actual else "Aplicar otra vez")
        aplicar.add_css_class("store-instalar")
        aplicar.add_css_class("suggested-action")
        aplicar.connect("clicked", lambda *_, n=t["n"], nm=t["nombre"]: self.aplicar(n, nm))
        acciones.append(aplicar)

        carpeta = Gtk.Button(label="Carpeta")
        carpeta.add_css_class("flat")
        carpeta.set_tooltip_text("Abrir la carpeta donde está este fondo")
        carpeta.connect("clicked", lambda *_, f=t["fondo"]: self.abrir_carpeta(f))
        acciones.append(carpeta)

        quitar = Gtk.Button(label="Quitar")
        quitar.add_css_class("flat")
        quitar.set_tooltip_text("Quitar este fondo de la lista (el archivo no se borra)")
        quitar.connect("clicked", lambda *_, n=t["n"]: self.quitar_fondo(n))
        acciones.append(quitar)
        caja.append(acciones)

        caja.set_tooltip_text(f"{t['nombre']}\n{t['fondo']}\nIconos: {t['iconos'] or '—'}")
        return caja

    def quitar_fondo(self, numero):
        """Quita de la lista el fondo número `numero` (no borra el archivo)."""
        try:
            lineas = LISTA.read_text(encoding="utf-8", errors="replace").splitlines()
        except Exception:
            return

        validas = 0
        salida = []
        quitado = False
        for linea in lineas:
            s = linea.strip()
            if not s or s.startswith("#"):
                salida.append(linea)
                continue
            validas += 1
            if validas == numero and not quitado:
                quitado = True
                continue
            salida.append(linea)

        if not quitado:
            return
        LISTA.write_text("\n".join(salida) + "\n", encoding="utf-8")

        # el "tema actual" se guarda como número de línea: hay que recolocarlo
        try:
            act = int(ACTUAL.read_text(encoding="utf-8").strip())
        except Exception:
            act = 0
        if act:
            if numero < act:
                ACTUAL.write_text(str(act - 1), encoding="utf-8")
            elif numero == act:
                ACTUAL.unlink(missing_ok=True)

        self.estado.set_text("Fondo quitado de la lista (el archivo sigue en disco).")
        self.cargar()

    def abrir_carpeta(self, ruta):
        if not ruta:
            return
        carpeta = str(Path(ruta).parent)
        abrir_carpeta(carpeta)

    def traducir_nombres(self):
        """Traduce al español los nombres de tema que vengan en otro idioma."""
        if self.traduciendo:
            return
        # Solo se traducen nombres de varias palabras: los de una sola suelen
        # ser nombres propios ("Arch", "Nord", "Bosque") y el traductor los
        # destrozaba (Arch -> Arco).
        pendientes = [
            t for t in self.temas
            if t["nombre"] and len(t["nombre"].split()) > 1
            and t["nombre"] not in _cache_trad()
        ]
        if not pendientes:
            return
        self.traduciendo = True

        def trabajo():
            for t in pendientes:
                es, idioma = traducir_nombre(t["nombre"])
                if es and idioma and idioma != "es" and es.strip().lower() != t["nombre"].strip().lower():
                    GLib.idle_add(self.poner_traduccion, t["n"], es)
                time.sleep(0.2)
            GLib.idle_add(self.fin_traduccion)

        threading.Thread(target=trabajo, daemon=True).start()

    def poner_traduccion(self, n, texto):
        etiqueta = self.etiquetas.get(n)
        if etiqueta is not None:
            etiqueta.set_text(texto)
        return False

    def fin_traduccion(self):
        self.traduciendo = False
        return False

    def filtrar(self):
        texto = self.busqueda.get_text().strip().lower()
        if self.modo == "biblioteca":
            for ruta in self.fondos_biblioteca:
                tarjeta = self.botones.get(ruta)
                if tarjeta is not None:
                    tarjeta.set_visible(not texto or texto in ruta.lower())
            return
        for t in self.temas:
            tarjeta = self.botones.get(t["n"])
            if tarjeta is None:
                continue
            visible = not texto or texto in t["nombre"].lower() or texto in t["fondo"].lower()
            tarjeta.set_visible(visible)

    # ── acciones ────────────────────────────────────────────────────────────
    def aplicar(self, n, nombre):
        if not CAMBIAR.exists():
            self.estado.set_text("No encuentro cambiar-tema.sh")
            return
        self.estado.set_text(f"Aplicando el tema {n}: {nombre}…")
        self.set_cursor_from_name("wait")

        def trabajo():
            try:
                subprocess.run(
                    [str(CAMBIAR), "aplicar", str(n)],
                    check=False, capture_output=True, timeout=180,
                )
                ok = True
            except Exception:
                ok = False
            GLib.idle_add(self.fin_aplicar, n, nombre, ok)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_aplicar(self, n, nombre, ok):
        self.set_cursor_from_name(None)
        self.estado.set_text(
            f"Tema {n} aplicado: {nombre}" if ok else f"No pude aplicar el tema {n}"
        )
        self.cargar()
        return False

    def on_aleatorio(self, *_):
        import random

        if self.temas:
            t = random.choice(self.temas)
            self.aplicar(t["n"], t["nombre"])

    def on_anadir(self, *_):
        dialogo = Gtk.FileDialog(title="Elige un fondo de pantalla")
        filtro = Gtk.FileFilter()
        filtro.set_name("Imágenes")
        for patron in ("*.png", "*.jpg", "*.jpeg", "*.webp", "*.avif"):
            filtro.add_pattern(patron)
        guardados = Gio.ListStore.new(Gtk.FileFilter)
        guardados.append(filtro)

        def hecho(dlg, resultado):
            try:
                f = dlg.open_finish(resultado)
            except Exception:
                return
            if f is None:
                return
            ruta = f.get_path()
            nombre = Path(ruta).stem.replace("_", " ")[:40]
            with LISTA.open("a", encoding="utf-8") as fh:
                fh.write(f"{nombre}|{ruta}|{ICONO_POR_DEFECTO}\n")
            self.estado.set_text(f"Añadido: {nombre}")
            self.cargar()

        dialogo.open(self, None, hecho)

    def on_descargar(self, *_):
        ventana = VentanaDescarga(self)
        ventana.present()



# ────────────────────────────── temas de color ──────────────────────────────
def paletas_disponibles():
    """Lista (id, nombre) de los temas de color descargados."""
    try:
        r = subprocess.run([str(PALETA), "listar"], capture_output=True, text=True, timeout=20)
    except Exception:
        return []
    salida = []
    for linea in r.stdout.splitlines():
        if "\t" in linea:
            ident, nombre = linea.split("\t", 1)
            salida.append((ident.strip(), nombre.strip()))
    return salida


class PaletasPage(Gtk.Box):
    """Rejilla con vista previa de cada paleta descargada (Catppuccin, Nord…)."""

    def __init__(self, ventana):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.ventana = ventana
        self.botones = {}

        barra = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        barra.add_css_class("page-toolbar")

        self.busqueda = Gtk.SearchEntry(placeholder_text="Buscar tema de color…")
        self.busqueda.set_hexpand(True)
        self.busqueda.connect("search-changed", lambda *_: self.filtrar())
        barra.append(self.busqueda)

        self.con_fondo = Gtk.CheckButton(label="Con el fondo del tema")
        self.con_fondo.set_active(True)
        self.con_fondo.set_tooltip_text(
            "Pone también el fondo de pantalla del tema; DMS recolorea la barra y los menús a partir de él"
        )
        barra.append(self.con_fondo)

        btn_descargar = Gtk.Button(label="Descargar / actualizar")
        btn_descargar.set_tooltip_text("Baja las paletas de los repositorios de temas")
        btn_descargar.add_css_class("suggested-action")
        btn_descargar.connect("clicked", self.on_descargar)
        barra.append(btn_descargar)

        btn_restaurar = Gtk.Button(label="Volver al sistema")
        btn_restaurar.set_tooltip_text("Deshace la paleta aplicada y deja tus colores de siempre")
        btn_restaurar.add_css_class("flat")
        btn_restaurar.connect("clicked", self.on_restaurar)
        barra.append(btn_restaurar)

        self.flujo = Gtk.FlowBox()
        self.flujo.set_valign(Gtk.Align.START)
        self.flujo.set_max_children_per_line(4)
        self.flujo.set_min_children_per_line(1)
        self.flujo.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flujo.set_margin_top(8)
        self.flujo.set_margin_bottom(8)
        self.flujo.set_margin_start(10)
        self.flujo.set_margin_end(10)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.flujo)

        self.etiqueta = Gtk.Label(label="")
        self.etiqueta.set_xalign(0)
        self.etiqueta.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.etiqueta)

        self.append(scroll)

        self.append(pie)
        self.cargar()

    def cargar(self):
        while (hijo := self.flujo.get_first_child()) is not None:
            self.flujo.remove(hijo)
        self.botones.clear()

        paletas = paletas_disponibles()
        if not paletas:
            self.etiqueta.set_text('No hay temas de color todavía. Pulsa "Descargar / actualizar temas".')
            return

        actual = ""
        try:
            actual = (CACHE_PALETAS / "actual").read_text(encoding="utf-8").strip()
        except Exception:
            pass

        for ident, nombre in paletas:
            self.flujo.append(self.tarjeta(ident, nombre, ident == actual))
        self.etiqueta.set_text(f"{len(paletas)} temas de color · pulsa uno para aplicarlo")

    def tarjeta(self, ident, nombre, activo):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

        previa = CACHE_PALETAS / f"previa-{ident}.png"
        imagen = Gtk.Picture.new_for_paintable(None)
        if previa.exists():
            try:
                textura = Gdk.Texture.new_from_filename(str(previa))
                imagen = Gtk.Picture.new_for_paintable(textura)
            except Exception:
                pass
        imagen.set_content_fit(Gtk.ContentFit.COVER)
        imagen.set_size_request(THUMB_W // 2, THUMB_H // 2)

        marco = Gtk.Frame()
        marco.set_child(imagen)
        marco.add_css_class("card")

        rotulo = Gtk.Label(label=nombre)
        rotulo.set_ellipsize(3)
        rotulo.set_max_width_chars(28)
        rotulo.add_css_class("heading")

        caja.append(marco)
        caja.append(rotulo)
        if activo:
            et = Gtk.Label(label="● aplicado")
            et.add_css_class("accent")
            caja.append(et)

        boton = Gtk.Button()
        boton.set_child(caja)
        boton.add_css_class("flat")
        boton.set_tooltip_text(f"Aplicar el tema {nombre}")
        boton.connect("clicked", lambda *_, i=ident, n=nombre: self.aplicar(i, n))
        self.botones[ident] = boton
        return boton

    def filtrar(self):
        texto = self.busqueda.get_text().strip().lower()
        for ident, boton in self.botones.items():
            nombre = (boton.get_tooltip_text() or ident).lower()
            boton.set_visible(not texto or texto in nombre or texto in ident.lower())

    def on_descargar(self, *_):
        self.etiqueta.set_text("Descargando temas… (puede tardar un poco)")

        def trabajo():
            try:
                subprocess.run([str(PALETA), "descargar"], capture_output=True, timeout=600)
            except Exception:
                pass
            GLib.idle_add(self.fin_descarga)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_descarga(self):
        self.cargar()
        self.generar_previas()
        return False

    def generar_previas(self):
        def trabajo():
            for ident, _ in paletas_disponibles():
                previa = CACHE_PALETAS / f"previa-{ident}.png"
                if previa.exists():
                    continue
                try:
                    subprocess.run([str(PALETA), "previa", ident], capture_output=True, timeout=30)
                except Exception:
                    pass
            GLib.idle_add(self.cargar)

        threading.Thread(target=trabajo, daemon=True).start()

    def aplicar(self, ident, nombre):
        self.etiqueta.set_text(f"Aplicando {nombre}…")

        def trabajo():
            try:
                orden = [str(PALETA), "aplicar", ident]
                if self.con_fondo.get_active():
                    orden.append("--fondo")
                subprocess.run(orden, capture_output=True, timeout=180)
                ok = True
            except Exception:
                ok = False
            GLib.idle_add(self.fin_aplicar, ident, nombre, ok)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_aplicar(self, ident, nombre, ok):
        self.etiqueta.set_text(f"Tema {nombre} aplicado" if ok else f"No pude aplicar {nombre}")
        self.cargar()
        return False

    def on_restaurar(self, *_):
        try:
            subprocess.run([str(PALETA), "restaurar"], capture_output=True, timeout=60)
        except Exception:
            pass
        self.etiqueta.set_text("Vuelto al tema del sistema")
        self.cargar()





# ────────────────────────────── sonido ──────────────────────────────────────
CONFIG_SONIDO = Path.home() / ".config" / "hyprbazar" / "sonido.json"
AUDIO_PACKS = Path.home() / ".local" / "share" / "mechsim" / "audio"
JUGADOR = Path.home() / ".local" / "bin" / "teclado-sonido"
TEMA_REPO = Path.home() / ".local" / "bin" / "hyprbazar-tema"
TECLAS = Path.home() / ".local" / "bin" / "hyprbazar-teclas"


def leer_sonido():
    try:
        return json.loads(CONFIG_SONIDO.read_text(encoding="utf-8"))
    except Exception:
        return {"activo": False, "pack": "cherrymx-blue-pbt", "volumen": 60}


def guardar_sonido(datos):
    try:
        CONFIG_SONIDO.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_SONIDO.write_text(json.dumps(datos, ensure_ascii=False, indent=2), encoding="utf-8")
        return True
    except Exception:
        return False


def packs_sonido():
    if not AUDIO_PACKS.is_dir():
        return []
    return sorted(p.name for p in AUDIO_PACKS.iterdir() if p.is_dir())


def parar_sonido():
    """Mata las instancias del reproductor (sin matarse a sí mismo)."""
    import os
    yo = os.getpid()
    for entrada in Path("/proc").iterdir():
        if not entrada.name.isdigit():
            continue
        pid = int(entrada.name)
        if pid == yo:
            continue
        try:
            cmd = (entrada / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
        except Exception:
            continue
        if "teclado-sonido" in cmd and "hyprbazar" not in cmd:
            try:
                os.kill(pid, 15)
            except Exception:
                pass


def arrancar_sonido():
    if not JUGADOR.exists():
        return False
    try:
        subprocess.Popen([str(JUGADOR)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def sonido_activo():
    for entrada in Path("/proc").iterdir():
        if not entrada.name.isdigit():
            continue
        try:
            cmd = (entrada / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
        except Exception:
            continue
        if "teclado-sonido" in cmd and "hyprbazar" not in cmd:
            return True
    return False


class TecladoVisual(Gtk.Box):
    """Teclado en pantalla que se ilumina con las teclas que vas pulsando."""

    FILAS = (
        ("1", "2", "3", "4", "5", "6", "7", "8", "9", "0"),
        ("Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"),
        ("A", "S", "D", "F", "G", "H", "J", "K", "L", "Ñ"),
        ("Z", "X", "C", "V", "B", "N", "M", ",", ".", "-"),
        ("Espacio",),
    )

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add_css_class("teclado-visual")
        self.teclas = {}
        for fila in self.FILAS:
            linea = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            linea.set_halign(Gtk.Align.CENTER)
            for etiqueta in fila:
                tecla = Gtk.Label(label=etiqueta)
                tecla.add_css_class("tecla")
                if etiqueta == "Espacio":
                    tecla.set_size_request(320, -1)
                else:
                    tecla.set_size_request(52, -1)
                linea.append(tecla)
                self.teclas[etiqueta] = tecla
            self.append(linea)

    def iluminar(self, etiqueta):
        tecla = self.teclas.get(etiqueta)
        if tecla is None:
            return False
        tecla.add_css_class("tecla-pulsada")

        def apagar():
            tecla.remove_css_class("tecla-pulsada")
            return False

        GLib.timeout_add(160, apagar)
        return False


class HiloTeclas(threading.Thread):
    """Lee los teclados de /dev/input y llama a `callback` con la tecla pulsada.

    No reproduce nada: solo sirve para iluminar el teclado de la pestaña Sonido.
    Se ignoran los dispositivos virtuales (ydotool/uinput), igual que hace
    «teclado-sonido», para que el agente no haga saltar las teclas.
    """

    NOMBRES = {
        "KEY_SPACE": "Espacio", "KEY_ENTER": "Espacio", "KEY_KPENTER": "Espacio",
        "KEY_BACKSPACE": "BackSpace", "KEY_MINUS": "-", "KEY_COMMA": ",",
        "KEY_DOT": ".", "KEY_SEMICOLON": ";", "KEY_APOSTROPHE": "'",
        "KEY_SLASH": "/", "KEY_LEFTBRACE": "[", "KEY_RIGHTBRACE": "]",
        "KEY_EQUAL": "=", "KEY_GRAVE": "`", "KEY_BACKSLASH": "\\",
        "KEY_SEMICOLON": ";", "KEY_LEFTCTRL": "", "KEY_LEFTSHIFT": "",
        "KEY_TAB": "", "KEY_ESC": "",
    }

    def __init__(self, callback):
        super().__init__(daemon=True)
        self.callback = callback
        self.vivo = True

    def run(self):
        try:
            import evdev
            from evdev import ecodes
        except Exception:
            return
        dispositivos = []
        for ruta in evdev.list_devices():
            try:
                aparato = evdev.InputDevice(ruta)
            except Exception:
                continue
            teclas = aparato.capabilities().get(ecodes.EV_KEY, [])
            nombre = (aparato.name or "").lower()
            if not (ecodes.KEY_A in teclas and ecodes.KEY_Z in teclas):
                continue
            if any(x in nombre for x in ("ydotool", "virtual", "uinput")):
                continue
            if aparato.info.vendor == 0x2333:
                continue
            dispositivos.append(aparato)
        if not dispositivos:
            return
        import selectors
        sel = selectors.DefaultSelector()
        for aparato in dispositivos:
            sel.register(aparato, selectors.EVENT_READ)
        try:
            while self.vivo:
                for clave, _ in sel.select(timeout=0.5):
                    try:
                        for evento in clave.fileobj.read():
                            if evento.type != ecodes.EV_KEY or evento.value != 1:
                                continue
                            nombre = ecodes.KEY.get(evento.code)
                            if not nombre or not nombre.startswith("KEY_"):
                                continue
                            if nombre in self.NOMBRES:
                                etiqueta = self.NOMBRES[nombre]
                            else:
                                sufijo = nombre[4:]
                                etiqueta = sufijo if len(sufijo) == 1 else ""
                            if etiqueta:
                                GLib.idle_add(self.callback, etiqueta)
                    except OSError:
                        try:
                            sel.unregister(clave.fileobj)
                        except Exception:
                            pass
        finally:
            for aparato in dispositivos:
                try:
                    aparato.close()
                except Exception:
                    pass

    def parar(self):
        self.vivo = False


DIR_TECLAS = Path.home() / ".local" / "share" / "hyprbazar" / "teclas"


TECLAS_REALES = DIR_TECLAS / "reales"
TIPOS_INTERRUPTOR = ("blue", "red", "brown", "black", "silver", "green",
                     "turquoise", "purple", "white")


def tipo_interruptor(nombre):
    """Tipo de interruptor del pack ('blue', 'red'…) o None."""
    bajo = (nombre or "").lower()
    for tipo in TIPOS_INTERRUPTOR:
        if tipo in bajo:
            return tipo
    return None


def imagen_pack(nombre):
    """Imagen del pack: foto real si la hay, si no una tecla dibujada."""
    if not nombre:
        return None
    # 1) foto real descargada con hyprbazar-teclas
    tipo = tipo_interruptor(nombre)
    if tipo:
        for extension in ("jpg", "png", "jpeg", "webp"):
            foto = TECLAS_REALES / f"{tipo}.{extension}"
            if foto.exists() and foto.stat().st_size > 2000:
                return foto
    # 2) tecla dibujada (se genera la primera vez)
    DIR_TECLAS.mkdir(parents=True, exist_ok=True)
    destino = DIR_TECLAS / f"{nombre}.png"
    if destino.exists():
        return destino
    magick = shutil.which("magick") or shutil.which("convert")
    if not magick:
        return None
    titulo, color, _ = describir_pack(nombre)
    # tonos para el cuerpo y la cara de la tecla a partir del color del interruptor
    cuerpo, cara = "#14181f", color
    partes = nombre.lower().split("-")
    material = "PBT" if "pbt" in nombre.lower() else ("ABS" if "abs" in nombre.lower() else "")
    subtitulo = " · ".join(x for x in (titulo.split(" (")[0], material) if x)
    orden = [
        magick, "-size", "360x200", "xc:#0b0e13",
        "-fill", "#1a1f27", "-draw", "roundrectangle 60,96 300,178 18,18",
        "-fill", cuerpo, "-draw", "roundrectangle 60,74 300,166 18,18",
        "-fill", cara, "-draw", "roundrectangle 68,82 292,158 14,14",
        "-fill", "#ffffff22", "-draw", "polygon 68,82 292,82 292,120 68,120",
        "-gravity", "center", "-pointsize", "28", "-fill", "#0b1220",
        "-annotate", "+0-26", titulo.split(" (")[0].upper()[:14],
        "-pointsize", "15", "-fill", "#0b1220cc",
        "-annotate", "+0+14", subtitulo[:24],
        str(destino),
    ]
    try:
        subprocess.run(orden, capture_output=True, timeout=60)
    except Exception:
        return None
    return destino if destino.exists() else None


DESCRIPCION_PACK = {
    "blue": ("Azul (clicky)", "#3b82f6", "sonido agudo y con clic, como un teclado mecánico clásico"),
    "red": ("Rojo (lineal)", "#ef4444", "pulsación suave y sin clic, la más silenciosa"),
    "brown": ("Marrón (táctil)", "#a16207", "un pequeño tope al pulsar, sin clic"),
    "black": ("Negro (lineal duro)", "#3f3f46", "más fuerza al pulsar, sonido más grave"),
    "travel": ("De viaje", "#0ea5e9", "portátil: teclas bajas y sonido apagado"),
    "mxblue": ("Azul (clicky)", "#3b82f6", "sonido agudo y con clic"),
    "mxred": ("Rojo (lineal)", "#ef4444", "pulsación suave y sin clic"),
    "mxbrown": ("Marrón (táctil)", "#a16207", "con tope táctil"),
}


def describir_pack(nombre):
    """Devuelve (título, color, descripción) a partir del nombre del pack."""
    bajo = nombre.lower().replace("-", " ").replace("_", " ")
    for clave, datos in DESCRIPCION_PACK.items():
        if clave in bajo:
            return datos
    return (nombre, "#64748b", "pack de sonido de la comunidad")


class SonidoPage(Gtk.Box):
    """Sonido de teclado al escribir: pack, volumen y encendido."""

    def __init__(self, ventana):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.ventana = ventana
        self.ajustes = leer_sonido()
        self._listo = False

        self.interruptor = Gtk.Switch()
        self.interruptor.set_active(bool(self.ajustes.get("activo")))
        self.interruptor.set_valign(Gtk.Align.CENTER)
        self.interruptor.connect("notify::active", self.on_activar)

        self.estado = Gtk.Label(label="")
        self.estado.set_xalign(0)
        self.estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.estado)

        # ── contenido: una tarjeta centrada, no un formulario suelto ──
        tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        tarjeta.add_css_class("tarjeta-ajustes")
        tarjeta.set_size_request(640, -1)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        titulo = Gtk.Label(label="Sonido al escribir")
        titulo.set_xalign(0)
        titulo.add_css_class("title-3")
        titulo.set_hexpand(True)
        head.append(titulo)
        self.interruptor.set_tooltip_text("Encender o apagar el sonido de las teclas")
        head.append(self.interruptor)
        self.chip = Gtk.Label(label="Apagado")
        self.chip.add_css_class("chip-estado")
        head.append(self.chip)
        tarjeta.append(head)

        explicacion = Gtk.Label(
            label="Cada tecla suena con el pack elegido. Se lee /dev/input, así que "
                  "hace falta pertenecer al grupo «input» y se arranca al iniciar sesión."
        )
        explicacion.set_wrap(True)
        explicacion.set_xalign(0)
        explicacion.add_css_class("store-desc")
        tarjeta.append(explicacion)

        # pack
        bloque_pack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        titulo_pack = Gtk.Label(label="Pack de sonido")
        titulo_pack.set_xalign(0)
        titulo_pack.add_css_class("heading")
        bloque_pack.append(titulo_pack)
        self.pack_sel = self.ajustes.get("pack", "")
        self.galeria_packs = Gtk.FlowBox()
        self.galeria_packs.set_homogeneous(True)
        self.galeria_packs.set_max_children_per_line(3)
        self.galeria_packs.set_min_children_per_line(2)
        self.galeria_packs.set_selection_mode(Gtk.SelectionMode.NONE)
        self.galeria_packs.set_row_spacing(8)
        self.galeria_packs.set_column_spacing(8)
        fila_img = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.btn_fotos = Gtk.Button(label="Descargar fotos reales")
        self.btn_fotos.add_css_class("flat")
        self.btn_fotos.set_tooltip_text(
            "Baja fotos reales de los interruptores (Cherry MX azul, rojo, marrón…) "
            "de Wikimedia Commons, que son de licencia libre")
        self.btn_fotos.connect("clicked", lambda *_: self.descargar_fotos())
        fila_img.append(self.btn_fotos)
        bloque_pack.append(fila_img)
        bloque_pack.append(self.galeria_packs)
        self.rellenar_galeria()

        # ficha visual: qué teclas estás usando (color y tacto)
        ficha = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.punto_pack = Gtk.Label()
        self.punto_pack.set_size_request(18, 18)
        self.punto_pack.set_valign(Gtk.Align.CENTER)
        ficha.append(self.punto_pack)
        self.texto_pack = Gtk.Label()
        self.texto_pack.set_xalign(0)
        self.texto_pack.set_wrap(True)
        self.texto_pack.add_css_class("store-desc")
        ficha.append(self.texto_pack)
        bloque_pack.append(ficha)
        self.actualizar_ficha_pack()
        tarjeta.append(bloque_pack)

        # volumen
        bloque_vol = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        fila_titulo = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        titulo_vol = Gtk.Label(label="Volumen")
        titulo_vol.set_xalign(0)
        titulo_vol.add_css_class("heading")
        titulo_vol.set_hexpand(True)
        fila_titulo.append(titulo_vol)
        self.valor_vol = Gtk.Label(label="")
        self.valor_vol.add_css_class("store-desc")
        fila_titulo.append(self.valor_vol)
        bloque_vol.append(fila_titulo)

        self.escala = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        self.escala.set_value(float(self.ajustes.get("volumen", 60)))
        self.escala.set_hexpand(True)
        self.escala.set_draw_value(False)
        self.escala.connect("value-changed", self.on_cambiar_volumen)
        bloque_vol.append(self.escala)
        tarjeta.append(bloque_vol)

        # teclado en pantalla: se ilumina con lo que escribes
        bloque_teclado = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        etiqueta_teclado = Gtk.Label(label="Tus teclas")
        etiqueta_teclado.set_xalign(0)
        etiqueta_teclado.add_css_class("heading")
        bloque_teclado.append(etiqueta_teclado)
        self.teclado = TecladoVisual()
        bloque_teclado.append(self.teclado)
        pista = Gtk.Label(
            label="Se ilumina la tecla que pulsas, para comprobar que se está leyendo "
                  "el teclado correcto.")
        pista.set_wrap(True)
        pista.set_xalign(0)
        pista.add_css_class("store-desc")
        bloque_teclado.append(pista)
        tarjeta.append(bloque_teclado)

        # botón de prueba
        fila_boton = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        probar = Gtk.Button(label="Probar el sonido")
        probar.add_css_class("store-instalar")
        probar.add_css_class("suggested-action")
        probar.connect("clicked", self.on_probar)
        fila_boton.append(probar)
        tarjeta.append(fila_boton)

        # centrar la tarjeta en la pestaña
        centro = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        centro.set_halign(Gtk.Align.CENTER)
        centro.set_valign(Gtk.Align.START)
        centro.set_margin_top(28)
        centro.set_margin_bottom(28)
        centro.set_margin_start(16)
        centro.set_margin_end(16)
        centro.append(tarjeta)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(centro)

        self.append(scroll)

        self._hilo_teclas = None
        self.connect("map", self._arrancar_teclas)
        self.connect("unmap", self._parar_teclas)
        self.append(pie)
        self._listo = True
        self.actualizar_estado()

    # ── helpers ─────────────────────────────────────────────────────────────
    def actualizar_ficha_pack(self):
        nombre = self.pack_actual()
        titulo, color, descripcion = describir_pack(nombre)
        self.punto_pack.set_markup(
            f"<span foreground='{color}' size='x-large'>●</span>")
        self.texto_pack.set_text(f"{titulo}: {descripcion}")

    def pack_actual(self):
        return self.pack_sel or self.ajustes.get("pack", "")

    def rellenar_galeria(self):
        """Una tarjeta por pack, con su imagen de tecla y su botón Aplicar."""
        while (hijo := self.galeria_packs.get_first_child()) is not None:
            self.galeria_packs.remove(hijo)
        for pack in packs_sonido():
            tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            tarjeta.add_css_class("store-card")

            imagen = Gtk.Picture.new_for_paintable(None)
            ruta = imagen_pack(pack)
            if ruta:
                try:
                    imagen.set_paintable(Gdk.Texture.new_from_filename(str(ruta)))
                except Exception:
                    pass
            imagen.set_content_fit(Gtk.ContentFit.COVER)
            imagen.set_size_request(180, 100)
            marco = Gtk.Frame()
            marco.add_css_class("store-banner")
            marco.set_child(imagen)
            marco.set_overflow(Gtk.Overflow.HIDDEN)
            tarjeta.append(marco)

            fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            nombre = Gtk.Label(label=pack.replace("-", " "))
            nombre.set_xalign(0)
            nombre.set_ellipsize(3)
            nombre.set_hexpand(True)
            nombre.add_css_class("store-title")
            fila.append(nombre)
            if pack == self.pack_actual():
                chip = Gtk.Label(label="En uso")
                chip.add_css_class("store-badge")
                chip.add_css_class("store-badge-ok")
                fila.append(chip)
            tarjeta.append(fila)

            boton = Gtk.Button(label="Aplicar" if pack != self.pack_actual() else "Aplicar otra vez")
            boton.add_css_class("store-instalar")
            boton.add_css_class("suggested-action")
            boton.connect("clicked", lambda *_, p=pack: self.elegir_pack(p))
            tarjeta.append(boton)
            self.galeria_packs.append(tarjeta)

    def descargar_fotos(self):
        self.btn_fotos.set_sensitive(False)
        self.btn_fotos.set_label("Descargando fotos…")

        def trabajo():
            try:
                subprocess.run([str(TECLAS), "descargar"], capture_output=True, timeout=300)
            except Exception:
                pass
            GLib.idle_add(self._fin_fotos)

        threading.Thread(target=trabajo, daemon=True).start()

    def _fin_fotos(self):
        self.btn_fotos.set_sensitive(True)
        self.btn_fotos.set_label("Descargar fotos reales")
        self.rellenar_galeria()
        self.estado.set_text("Fotos reales listas (licencias en hyprbazar-teclas creditos)")
        return False

    def elegir_pack(self, pack):
        if self.pack_sel == pack:
            self.aplicar()
            return
        self.pack_sel = pack
        self.actualizar_ficha_pack()
        self.rellenar_galeria()
        self.aplicar()

    def _arrancar_teclas(self, *_):
        if self._hilo_teclas is None or not self._hilo_teclas.is_alive():
            self._hilo_teclas = HiloTeclas(self.teclado.iluminar)
            self._hilo_teclas.start()
        # si el interruptor está encendido pero el proceso no vive (tras un
        # reinicio de la app, por ejemplo), se vuelve a arrancar solo
        self._asegurar_daemon()
        return False

    def _asegurar_daemon(self):
        try:
            if self.interruptor.get_active() and not sonido_activo():
                arrancar_sonido()
                self.estado.set_text("Arrancando el sonido de teclado…")
        except Exception:
            pass

    def _parar_teclas(self, *_):
        if self._hilo_teclas is not None:
            self._hilo_teclas.parar()
            self._hilo_teclas = None
        return False

    def actualizar_estado(self):
        activo = sonido_activo()
        volumen = int(self.escala.get_value())
        self.estado.set_text(
            f"Pack: {self.pack_actual()} · volumen {volumen}% · "
            + ("reproduciendo" if activo else "apagado")
        )
        # chip de la tarjeta y valor del volumen al lado del deslizador
        try:
            self.chip.set_text("Encendido" if activo else "Apagado")
            self.chip.remove_css_class("chip-encendido")
            if activo:
                self.chip.add_css_class("chip-encendido")
        except Exception:
            pass
        try:
            self.valor_vol.set_text(f"{volumen} %")
        except Exception:
            pass

    def aplicar(self):
        self.ajustes = {
            "activo": self.interruptor.get_active(),
            "pack": self.pack_actual(),
            "volumen": int(self.escala.get_value()),
        }
        guardar_sonido(self.ajustes)
        parar_sonido()
        if self.ajustes["activo"]:
            arrancar_sonido()
        self.actualizar_estado()

    # ── eventos ─────────────────────────────────────────────────────────────
    def on_activar(self, *_):
        if not self._listo:
            return
        self.aplicar()

    def on_cambiar_volumen(self, *_):
        if not self._listo:
            return
        self.aplicar()

    def on_probar(self, *_):
        pack = self.pack_actual()
        volumen = int(self.escala.get_value())
        carpeta = AUDIO_PACKS / pack

        # Los packs de MechSim traen una grabación larga; "teclado-sonido" la
        # parte en golpes cortos y los guarda aquí. Preferimos esos trozos.
        trozos = sorted((Path.home() / ".cache" / "teclado-sonido" / pack).glob("*.ogg"))
        if trozos:
            sonido = random.choice(trozos)
        else:
            sonido = carpeta / "sound.ogg"
            if not sonido.exists():
                candidatos = sorted(carpeta.glob("*.ogg")) + sorted(carpeta.glob("*.wav"))
                if not candidatos:
                    self.estado.set_text("Ese pack no tiene sonidos.")
                    return
                sonido = candidatos[0]
        try:
            if shutil.which("paplay"):
                orden = ["paplay", f"--volume={int(volumen * 655.36)}", str(sonido)]
            elif shutil.which("ffplay"):
                orden = ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet",
                         "-volume", str(volumen), str(sonido)]
            else:
                orden = ["pw-play", str(sonido)]
            subprocess.Popen(orden, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.estado.set_text(f"Reproduciendo una muestra de {pack}…")
        except Exception:
            self.estado.set_text("No pude reproducir la muestra (¿falta paplay?).")


# ─────────────────────────── visor de capturas ──────────────────────────────
class VistaCapturas(Gtk.Window):
    """Enseña dentro de la app las capturas (y vídeos) del repo elegido."""

    CACHE_CAPTURAS = Path.home() / ".cache" / "tienda" / "capturas"
    VIDEO = (".mp4", ".webm", ".mov", ".mkv", ".gif")

    def __init__(self, padre, repo, urls, pagina_github):
        super().__init__(title=f"Capturas de {repo}", transient_for=padre, modal=False)
        self.set_default_size(980, 720)
        self.repo = repo
        self.urls = urls or []
        self.pagina_github = pagina_github

        cab = Gtk.HeaderBar()
        cab.set_title_widget(Gtk.Label(label=repo))
        self.set_titlebar(cab)

        ver_github = Gtk.Button(label="Ver en GitHub")
        ver_github.connect("clicked", lambda *_: abrir_url(pagina_github))
        cab.pack_end(ver_github)

        self.estado = Gtk.Label(label="")
        self.estado.set_xalign(0)
        self.estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.estado)

        self.flujo = Gtk.FlowBox()
        self.flujo.set_valign(Gtk.Align.START)
        self.flujo.set_homogeneous(True)
        self.flujo.set_max_children_per_line(2)
        self.flujo.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flujo.set_margin_top(10)
        self.flujo.set_margin_bottom(10)
        self.flujo.set_margin_start(12)
        self.flujo.set_margin_end(12)
        self.flujo.set_row_spacing(10)
        self.flujo.set_column_spacing(10)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.flujo)

        raiz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        raiz.append(scroll)
        raiz.append(pie)
        self.set_child(raiz)

        if not self.urls:
            self.estado.set_text("Este repo no enseña capturas en su README.")
        else:
            self.estado.set_text(f"{len(self.urls)} capturas · pulsa una para abrirla en grande")
            for u in self.urls:
                self.flujo.append(self.tarjeta(u))

    def ver_grande(self, url):
        """Abre la captura a tamaño grande dentro de la app (sin salir a nada)."""
        if self.es_video(url):
            # los vídeos sí necesitan reproductor
            abrir_url(url)
            return

        ventana = Gtk.Window(title="Captura", transient_for=self, modal=False)
        ventana.set_default_size(1100, 740)

        cab = Gtk.HeaderBar()
        cab.set_title_widget(Gtk.Label(label=self.repo))
        ventana.set_titlebar(cab)
        github = Gtk.Button(label="Ver en GitHub")
        github.connect("clicked", lambda *_: abrir_url(self.pagina_github))
        cab.pack_end(github)

        imagen = Gtk.Picture.new_for_paintable(None)
        imagen.set_content_fit(Gtk.ContentFit.CONTAIN)
        imagen.set_hexpand(True)
        imagen.set_vexpand(True)

        estado = Gtk.Label(label="Cargando la imagen…")
        estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(estado)

        raiz = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        raiz.add_css_class("ventana-captura")
        raiz.append(imagen)
        raiz.append(pie)
        ventana.set_child(raiz)
        ventana.present()

        base = self.cache_local(url)
        destino = base.parent / (base.stem + "-grande.png")

        def enseñar():
            if not destino.exists() or destino.stat().st_size < 500:
                return False
            try:
                textura = Gdk.Texture.new_from_filename(str(destino))
            except Exception:
                return False
            imagen.set_paintable(textura)
            estado.set_text(url.rsplit("/", 1)[-1])
            return False

        def traer():
            if destino.exists() and destino.stat().st_size > 500:
                GLib.idle_add(enseñar)
                return
            crudo = destino.with_suffix(".orig")
            try:
                subprocess.run(["curl", "-sSL", "--max-time", "60", "-o", str(crudo), url],
                               capture_output=True, timeout=70)
                subprocess.run(["magick", str(crudo), "-resize", "1600x1600>",
                                "-strip", str(destino)], capture_output=True, timeout=40)
                crudo.unlink(missing_ok=True)
            except Exception:
                pass
            GLib.idle_add(enseñar)

        threading.Thread(target=traer, daemon=True).start()

    def es_video(self, url):
        return url.lower().endswith(self.VIDEO)

    def cache_local(self, url):
        self.CACHE_CAPTURAS.mkdir(parents=True, exist_ok=True)
        import hashlib

        clave = hashlib.sha1(url.encode()).hexdigest()[:16]
        return self.CACHE_CAPTURAS / f"{clave}.png"

    def tarjeta(self, url):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        caja.add_css_class("wall-card")

        imagen = Gtk.Picture.new_for_paintable(None)
        imagen.set_content_fit(Gtk.ContentFit.COVER)
        imagen.set_can_shrink(True)
        imagen.set_hexpand(True)
        imagen.set_size_request(320, 180)

        marco = Gtk.Frame()
        marco.add_css_class("store-banner")
        marco.set_child(imagen)
        marco.set_overflow(Gtk.Overflow.HIDDEN)

        boton = Gtk.Button()
        boton.set_child(marco)
        boton.add_css_class("flat")
        boton.set_tooltip_text("Abrir en grande" if not self.es_video(url) else "Reproducir el vídeo")
        boton.connect("clicked", lambda *_, u=url: self.ver_grande(u))
        caja.append(boton)

        destino = self.cache_local(url)

        def enseñar():
            if not destino.exists() or destino.stat().st_size < 500:
                return False
            try:
                textura = Gdk.Texture.new_from_filename(str(destino))
            except Exception:
                return False
            imagen.set_paintable(textura)
            return False

        def descargar():
            if destino.exists() and destino.stat().st_size > 500:
                GLib.idle_add(enseñar)
                return
            try:
                if self.es_video(url):
                    # sacar un fotograma del vídeo como miniatura
                    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", "1",
                                    "-i", url, "-frames:v", "1",
                                    "-vf", "scale=640:-1", str(destino)],
                                   capture_output=True, timeout=90)
                else:
                    crudo = destino.with_suffix(".orig")
                    subprocess.run(["curl", "-sSL", "--max-time", "40", "-o", str(crudo), url],
                                   capture_output=True, timeout=50)
                    subprocess.run(["magick", str(crudo), "-thumbnail", "640x360^",
                                    "-gravity", "center", "-extent", "640x360",
                                    "-strip", str(destino)], capture_output=True, timeout=40)
                    crudo.unlink(missing_ok=True)
            except Exception:
                pass
            GLib.idle_add(enseñar)

        threading.Thread(target=descargar, daemon=True).start()

        pie_item = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        pie_item.add_css_class("wall-pie")
        tipo = Gtk.Label(label="Vídeo" if self.es_video(url) else "Imagen")
        tipo.add_css_class("store-badge")
        pie_item.append(tipo)
        nombre = Gtk.Label(label=url.rsplit("/", 1)[-1][:40])
        nombre.set_xalign(0)
        nombre.set_ellipsize(2)
        nombre.set_hexpand(True)
        nombre.add_css_class("store-desc")
        pie_item.append(nombre)
        caja.append(pie_item)
        return caja


# ────────────────────────────── tienda ──────────────────────────────────────
CSS_TIENDA = """
.store-card {
  background: alpha(currentColor, 0.05);
  border-radius: 14px;
  padding: 10px;
  transition: background 120ms ease-in-out;
}
.store-card:hover { background: alpha(currentColor, 0.09); }
.store-banner { border-radius: 10px; background: alpha(currentColor, 0.10); }
.store-title { font-weight: 700; font-size: 1.02em; }
.store-desc { opacity: 0.72; font-size: 0.92em; }
.store-badge {
  background: alpha(currentColor, 0.12);
  border-radius: 999px;
  padding: 1px 10px;
  font-size: 0.82em;
}
.store-badge-ok { background: alpha(@accent_color, 0.25); }
.store-instalar { border-radius: 999px; font-weight: 600; }
.store-chip { border-radius: 999px; }
.store-vacio { opacity: 0.6; }
"""


class TiendaPage(Gtk.Box):
    """Tienda de temas de la comunidad: buscador, capturas y descripciones traducidas."""

    # nombre visible, búsqueda en GitHub y explicación (en el tooltip)
    CATEGORIAS = [
        ("Todo", "hyprland themes", "Temas de todo tipo, sin filtrar"),
        ("Escritorios", "hyprland dotfiles rice",
         "Rices: escritorios enteros ya montados (barras, widgets, colores…), listos para copiar ideas"),
        ("Fondos", "hyprland wallpapers", "Solo fondos de pantalla"),
        ("Barras", "quickshell hyprland shell",
         "Shells: programas que dibujan la barra, el dock y los widgets (quickshell, ags, eww)"),
        ("Catppuccin", "catppuccin hyprland",
         "Catppuccin: la paleta pastel más popular, con temas para casi todo"),
        ("Instalados", None,
         "Los temas que ya tienes descargados en este equipo: aplícalos sin volver a bajarlos"),
    ]

    def __init__(self, ventana):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.ventana = ventana
        self.resultados = []
        self.instalados = self._instalados()
        self._auto_hecho = False

        _cargar_css(CSS_TIENDA)

        # ── cabecera: buscador ──
        cab = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        cab.add_css_class("page-toolbar")

        self.busqueda = Gtk.SearchEntry(placeholder_text="Buscar temas, rices, fondos…")
        self.busqueda.set_hexpand(True)
        self.busqueda.connect("activate", self.on_buscar)
        cab.append(self.busqueda)

        self.btn_recargar = Gtk.Button(label="Recargar")
        self.btn_recargar.add_css_class("flat")
        self.btn_recargar.set_tooltip_text(
            "Vuelve a leer lo instalado (por si acabas de descargar un repo)")
        self.btn_recargar.connect("clicked", lambda *_: self.recargar())
        cab.append(self.btn_recargar)
        self.btn_buscar = Gtk.Button(label="Buscar")
        self.btn_buscar.add_css_class("suggested-action")
        self.btn_buscar.connect("clicked", self.on_buscar)
        cab.append(self.btn_buscar)

        # ── categorías ──
        chips = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        chips.set_margin_top(2)
        chips.set_margin_start(14)
        chips.set_margin_end(14)
        for nombre, consulta, ayuda in self.CATEGORIAS:
            b = Gtk.Button(label=nombre)
            b.add_css_class("store-chip")
            b.add_css_class("flat")
            b.set_tooltip_text(ayuda)
            b.connect("clicked", lambda *_, q=consulta: self.buscar(q))
            chips.append(b)

        self.estado = Gtk.Label(label="Busca temas de la comunidad; las descripciones se traducen solas.")
        self.estado.set_xalign(0)
        self.estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.estado)

        # ── rejilla de resultados ──
        self.flujo = Gtk.FlowBox()
        self.flujo.set_valign(Gtk.Align.START)
        self.flujo.set_max_children_per_line(2)
        self.flujo.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flujo.set_margin_top(8)
        self.flujo.set_margin_bottom(16)
        self.flujo.set_margin_start(14)
        self.flujo.set_margin_end(14)
        self.flujo.set_row_spacing(10)
        self.flujo.set_column_spacing(10)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.flujo)

        self.append(cab)
        self.append(chips)
        self.append(scroll)

        self.append(pie)

    # ── estado interno ──────────────────────────────────────────────────────
    @staticmethod
    def _instalados():
        try:
            r = subprocess.run([str(TIENDA), "instalados"], capture_output=True, text=True, timeout=10)
            return set(r.stdout.split())
        except Exception:
            return set()

    def on_buscar(self, *_):
        consulta = self.busqueda.get_text().strip() or "hyprland themes"
        self.buscar(consulta)

    def buscar(self, consulta):
        if not consulta:                     # chip "Instalados"
            self.busqueda.set_text("")
            self.btn_buscar.set_sensitive(True)
            self.mostrar_instalados()
            return
        self.busqueda.set_text(consulta)
        self.estado.set_text(f'Buscando «{consulta}» y traduciendo las descripciones…')
        self.btn_buscar.set_sensitive(False)
        while (h := self.flujo.get_first_child()) is not None:
            self.flujo.remove(h)
        self._esqueletos()

        def trabajo():
            try:
                r = subprocess.run([str(TIENDA), "buscar", consulta],
                                   capture_output=True, text=True, timeout=180)
                res = [json.loads(l) for l in r.stdout.splitlines() if l.strip().startswith("{")]
            except Exception:
                res = []
            GLib.idle_add(self.mostrar, res)

        threading.Thread(target=trabajo, daemon=True).start()

    def _esqueletos(self):
        for _ in range(4):
            caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            caja.add_css_class("store-card")
            hueco = Gtk.Box()
            hueco.add_css_class("store-banner")
            hueco.set_size_request(300, 150)
            caja.append(hueco)
            self.flujo.append(caja)

    def mostrar(self, resultados):
        self.resultados = resultados
        self.btn_buscar.set_sensitive(True)
        # las búsquedas van en rejilla normal (si venimos de "Instalados", que
        # usa tarjetas de varios tamaños, se restaura)
        self.flujo.set_homogeneous(True)
        self.instalados = self._instalados()
        while (h := self.flujo.get_first_child()) is not None:
            self.flujo.remove(h)
        if not resultados:
            self.estado.set_text("Sin resultados. Prueba otra búsqueda (GitHub limita las peticiones seguidas).")
            vacio = Gtk.Label()
            vacio.set_markup(
                "<span size='x-large'>Busca temas de la comunidad</span>\n\n"
                "Escribe arriba (por ejemplo <b>catppuccin</b>, <b>hyprland dots</b> "
                "o <b>quickshell</b>) o pulsa una categoría.\n"
                "Las descripciones se traducen al español solas.")
            vacio.set_justify(Gtk.Justification.CENTER)
            vacio.add_css_class("dim-label")
            vacio.set_margin_top(60)
            self.flujo.append(vacio)
            return
        for r in resultados:
            self.flujo.append(self.tarjeta(r))
        self.estado.set_text(f"{len(resultados)} resultados · descripciones traducidas al español")

    def tarjeta(self, r):
        repo = r.get("repo", "")
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")

        banner = self._banner(r.get("banner") or r.get("imagen", ""), repo, r.get("lenguaje", ""))
        caja.append(banner)

        fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        titulo = Gtk.Label(label=repo)
        titulo.set_xalign(0)
        titulo.set_ellipsize(3)
        titulo.add_css_class("store-title")
        fila.append(titulo)
        estrellas = Gtk.Label(label=f"★ {r.get('estrellas', 0):,}".replace(",", "."))
        estrellas.add_css_class("store-badge")
        fila.append(estrellas)
        if repo in self.instalados:
            ok = Gtk.Label(label="Instalado")
            ok.add_css_class("store-badge")
            ok.add_css_class("store-badge-ok")
            fila.append(ok)
        caja.append(fila)

        desc = r.get("descripcion_es") or r.get("descripcion") or "Sin descripción"
        etiqueta = Gtk.Label(label=desc)
        etiqueta.set_wrap(True)
        etiqueta.set_lines(3)
        etiqueta.set_ellipsize(3)
        etiqueta.set_xalign(0)
        etiqueta.set_max_width_chars(60)
        etiqueta.add_css_class("store-desc")
        caja.append(etiqueta)

        acciones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        instalar = Gtk.Button(label="Instalar" if repo not in self.instalados else "Actualizar")
        instalar.add_css_class("store-instalar")
        instalar.add_css_class("suggested-action")
        instalar.connect("clicked", lambda *_, rr=repo, b=instalar: self.instalar(rr, b))
        acciones.append(instalar)

        capturas_btn = Gtk.Button(label="Ver capturas")
        capturas_btn.add_css_class("flat")
        capturas_btn.set_tooltip_text("Ver las imágenes y vídeos del repo sin salir de la app")
        capturas_btn.connect("clicked", lambda *_, rr=r: self.ver_capturas(rr))
        acciones.append(capturas_btn)

        ver = Gtk.Button(label="Ver en GitHub")
        ver.add_css_class("flat")
        ver.connect("clicked", lambda *_, u=r.get("url", ""): abrir_url(u))
        acciones.append(ver)
        caja.append(acciones)

        # ── aplicar el aspecto del repo (colores y formas, nada de binds) ──
        if repo in self.instalados:
            fila_tema = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            aplicado = self._tema_aplicado() == self._slug(repo)
            boton_tema = Gtk.Button(
                label="Aplicar tema" if not aplicado else "Aplicar otra vez")
            boton_tema.add_css_class("store-instalar")
            boton_tema.set_tooltip_text(
                "Aplica los colores, huecos y esquinas de este repo (no toca binds ni plugins)")
            boton_tema.connect("clicked",
                               lambda *_, rr=repo, b=boton_tema: self.aplicar_tema(rr, b))
            fila_tema.append(boton_tema)
            if aplicado:
                restaurar = Gtk.Button(label="Volver a como estaba")
                restaurar.add_css_class("flat")
                restaurar.connect("clicked", lambda *_: self.restaurar_tema())
                fila_tema.append(restaurar)
            caja.append(fila_tema)

        return caja

    @staticmethod
    def _slug(repo):
        return repo.replace("/", "-")

    def _tema_aplicado(self):
        try:
            r = subprocess.run([str(TEMA_REPO), "estado"], capture_output=True,
                               text=True, timeout=10)
            texto = r.stdout.strip()
            return texto.split(":", 1)[1].strip() if ":" in texto else ""
        except Exception:
            return ""

    def aplicar_tema(self, repo, boton):
        slug = self._slug(repo)
        boton.set_sensitive(False)
        self.estado.set_text(f"Aplicando el tema de {repo}…")

        def trabajo():
            try:
                r = subprocess.run([str(TEMA_REPO), "aplicar", slug],
                                   capture_output=True, text=True, timeout=180)
                salida = (r.stdout or "") + (r.stderr or "")
                ok = r.returncode == 0
            except Exception as error:  # noqa: BLE001
                salida, ok = str(error), False
            GLib.idle_add(self._fin_aplicar_tema, repo, ok, salida)

        threading.Thread(target=trabajo, daemon=True).start()

    def _fin_aplicar_tema(self, repo, ok, salida):
        if ok:
            self.estado.set_text(
                f"Tema de {repo} aplicado · si no te gusta, «Volver a como estaba»")
        else:
            ultimo = [l for l in salida.splitlines() if l.strip()]
            self.estado.set_text(
                "No pude aplicar el tema: " + (ultimo[-1] if ultimo else "sin detalles"))
        return False

    def restaurar_tema(self):
        def trabajo():
            try:
                subprocess.run([str(TEMA_REPO), "restaurar"], capture_output=True, timeout=180)
            except Exception:
                pass
            GLib.idle_add(lambda: (self.estado.set_text("Aspecto anterior restaurado"), False)[1])

        threading.Thread(target=trabajo, daemon=True).start()

    COLORES_LENGUAJE = {
        "Python": ("#2b5b84", "#12212f"), "Shell": ("#5c8a3a", "#1d2a15"),
        "Lua": ("#4a4aa8", "#151530"), "C": ("#4d4d4d", "#141414"),
        "C++": ("#8a3a5c", "#2a1220"), "QML": ("#4a8a3a", "#152a12"),
        "JavaScript": ("#8a7a1a", "#2a2508"), "Go": ("#1a6a8a", "#08222a"),
        "Rust": ("#7a3a1a", "#2a1408"), "HTML": ("#8a4a1a", "#2a1608"),
        "Nix": ("#3a5c8a", "#121c2a"), "CSS": ("#3a3a8a", "#12122a"),
    }

    def _banner(self, url, repo, lenguaje=""):
        """Captura real del repo si la hay; si no, una portada generada."""
        marco = Gtk.Frame()
        marco.add_css_class("store-banner")
        marco.set_size_request(300, 150)

        CACHE_TIENDA.mkdir(parents=True, exist_ok=True)
        clave = hashlib.sha1((url or repo).encode()).hexdigest()[:16]
        destino = CACHE_TIENDA / f"banner-{clave}.png"

        def poner():
            if not destino.exists() or destino.stat().st_size < 500:
                return False
            try:
                textura = Gdk.Texture.new_from_filename(str(destino))
            except Exception:
                return False
            imagen = Gtk.Picture.new_for_paintable(textura)
            imagen.set_content_fit(Gtk.ContentFit.COVER)
            imagen.set_can_shrink(True)
            marco.set_child(imagen)
            return False

        if destino.exists() and destino.stat().st_size > 500:
            poner()
            return marco

        def trabajo():
            magick = shutil.which("magick") or shutil.which("convert")
            if not magick:
                return
            if url:
                crudo = destino.with_suffix(".orig")
                try:
                    subprocess.run(["curl", "-sSL", "--max-time", "30", "-o", str(crudo), url],
                                   capture_output=True, timeout=40)
                except Exception:
                    pass
                if crudo.exists() and crudo.stat().st_size > 2000:
                    subprocess.run([magick, str(crudo), "-thumbnail", "480x270^",
                                    "-gravity", "center", "-extent", "480x270",
                                    "-strip", str(destino)], capture_output=True, timeout=40)
                    # si lo descargado no era una imagen de verdad, se descarta
                    chequeo = subprocess.run([magick, "identify", "-format", "%w", str(destino)],
                                             capture_output=True, text=True, timeout=15)
                    if chequeo.returncode != 0:
                        destino.unlink(missing_ok=True)
                    crudo.unlink(missing_ok=True)
            if not destino.exists() or destino.stat().st_size < 500:
                # portada generada: degradado del color del lenguaje + nombre
                c1, c2 = self.COLORES_LENGUAJE.get(lenguaje, ("#3a3a5c", "#16161f"))
                nombre = repo if len(repo) <= 28 else repo[:27] + "…"
                for fuente in ("Adwaita-Sans-Bold", "DejaVu Sans Bold", "Noto-Sans-Bold",
                               "JetBrainsMono-NF-Bold", "Adwaita-Sans"):
                    r = subprocess.run([magick, "-size", "480x270", f"gradient:{c1}-{c2}",
                                        "-gravity", "center", "-font", fuente,
                                        "-pointsize", "28", "-fill", "white",
                                        "-annotate", "0", nombre,
                                        "-gravity", "south", "-pointsize", "15",
                                        "-fill", "rgba(255,255,255,0.55)",
                                        "-annotate", "+0+18", "tema de la comunidad",
                                        "-strip", str(destino)],
                                       capture_output=True, timeout=30)
                    if destino.exists() and destino.stat().st_size > 500:
                        break
            if destino.exists() and destino.stat().st_size > 500:
                GLib.idle_add(poner)

        threading.Thread(target=trabajo, daemon=True).start()
        return marco

    def _cabecera_seccion(self, titulo, detalle):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        caja.set_size_request(700, -1)
        caja.set_margin_top(10)
        caja.set_margin_bottom(2)
        etiqueta = Gtk.Label(label=titulo)
        etiqueta.set_xalign(0)
        etiqueta.add_css_class("title-3")
        caja.append(etiqueta)
        sub = Gtk.Label(label=detalle)
        sub.set_xalign(0)
        sub.add_css_class("store-desc")
        caja.append(sub)
        return caja

    def _tarjeta_repo(self, repo):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")
        caja.set_size_request(320, -1)

        titulo = Gtk.Label(label=repo)
        titulo.set_xalign(0)
        titulo.set_ellipsize(3)
        titulo.add_css_class("store-title")
        caja.append(titulo)

        slug = self._slug(repo)
        aplicado = self._tema_aplicado() == slug
        if aplicado:
            chip = Gtk.Label(label="Aplicado")
            chip.add_css_class("store-badge")
            chip.add_css_class("store-badge-ok")
            caja.append(chip)

        botones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        aplicar = Gtk.Button(label="Aplicar tema")
        aplicar.add_css_class("store-instalar")
        aplicar.add_css_class("suggested-action")
        aplicar.connect("clicked", lambda *_, r=repo, b=aplicar: self.aplicar_tema(r, b))
        botones.append(aplicar)
        carpeta = Gtk.Button(label="Carpeta")
        carpeta.add_css_class("flat")
        carpeta.connect("clicked", lambda *_, r=repo: abrir_carpeta(str(DATOS_TIENDA / slug)))
        botones.append(carpeta)
        caja.append(botones)
        return caja

    def _tarjeta_fondo_descargado(self, ruta):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")
        caja.set_size_request(240, -1)

        imagen = Gtk.Picture.new_for_paintable(None)
        thumb = miniatura(str(ruta))
        if thumb:
            try:
                imagen.set_paintable(Gdk.Texture.new_from_filename(str(thumb)))
            except Exception:
                pass
        imagen.set_content_fit(Gtk.ContentFit.COVER)
        imagen.set_size_request(220, 120)
        marco = Gtk.Frame()
        marco.add_css_class("store-banner")
        marco.set_child(imagen)
        marco.set_overflow(Gtk.Overflow.HIDDEN)
        caja.append(marco)

        titulo = Gtk.Label(label=ruta.stem.replace("_", " ")[:34])
        titulo.set_xalign(0)
        titulo.set_ellipsize(3)
        titulo.add_css_class("store-title")
        caja.append(titulo)

        aplicar = Gtk.Button(label="Poner de fondo")
        aplicar.add_css_class("store-instalar")
        aplicar.add_css_class("suggested-action")
        aplicar.connect("clicked", lambda *_, r=str(ruta): self.aplicar_fondo(r))
        caja.append(aplicar)
        return caja

    def mostrar_instalados(self):
        """Todo lo descargado (paletas, repos y fondos), con su botón de aplicar."""
        while (h := self.flujo.get_first_child()) is not None:
            self.flujo.remove(h)
        # tarjetas de distinto tamaño (las cabeceras de sección ocupan una fila)
        self.flujo.set_homogeneous(False)

        paletas = []
        if PALETAS_DIR.is_dir():
            for carpeta in sorted(PALETAS_DIR.iterdir()):
                if not (carpeta / "colors.json").exists():
                    continue
                nombre = carpeta.name
                try:
                    datos = json.loads((carpeta / "theme.json").read_text(encoding="utf-8"))
                    nombre = datos.get("name") or nombre
                except Exception:
                    pass
                paletas.append((carpeta.name, nombre))

        if not paletas:
            self.estado.set_text(
                "Todavía no tienes paletas descargadas. Usa «Descargar / actualizar» "
                "en la pestaña Temas de color, o instala un repo desde la tienda."
            )
            return

        actual = ""
        try:
            actual = (CACHE_PALETAS / "actual").read_text(encoding="utf-8").strip()
        except Exception:
            pass

        for ident, nombre in paletas:
            caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            caja.add_css_class("store-card")

            previa = CACHE_PALETAS / f"previa-{ident}.png"
            imagen = Gtk.Picture.new_for_paintable(None)
            if previa.exists():
                try:
                    imagen = Gtk.Picture.new_for_paintable(Gdk.Texture.new_from_filename(str(previa)))
                except Exception:
                    pass
            imagen.set_content_fit(Gtk.ContentFit.COVER)
            imagen.set_can_shrink(True)
            imagen.set_hexpand(True)
            imagen.set_size_request(240, 130)
            marco = Gtk.Frame()
            marco.add_css_class("store-banner")
            marco.set_child(imagen)
            marco.set_overflow(Gtk.Overflow.HIDDEN)
            caja.append(marco)

            fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            titulo = Gtk.Label(label=nombre)
            titulo.set_xalign(0)
            titulo.set_ellipsize(3)
            titulo.set_hexpand(True)
            titulo.add_css_class("store-title")
            fila.append(titulo)
            if ident == actual:
                chip = Gtk.Label(label="En uso")
                chip.add_css_class("store-badge")
                chip.add_css_class("store-badge-ok")
                fila.append(chip)
            caja.append(fila)

            sub = Gtk.Label(label=ident)
            sub.set_xalign(0)
            sub.add_css_class("store-desc")
            caja.append(sub)

            acciones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            aplicar = Gtk.Button(label="Aplicar")
            aplicar.add_css_class("store-instalar")
            aplicar.add_css_class("suggested-action")
            aplicar.connect("clicked", lambda *_, i=ident, n=nombre: self.aplicar_paleta(i, n))
            acciones.append(aplicar)
            caja.append(acciones)
            self.flujo.append(caja)

        # ── repos de la tienda ──
        repos = []
        try:
            r = subprocess.run([str(TIENDA), "instalados"], capture_output=True,
                               text=True, timeout=15)
            repos = [l.strip() for l in r.stdout.splitlines() if l.strip()]
        except Exception:
            repos = []
        if repos:
            self.flujo.append(self._cabecera_seccion(
                "Repos descargados",
                "Aplican su aspecto visual (colores, huecos, bordes y esquinas)"))
            for repo in repos:
                self.flujo.append(self._tarjeta_repo(repo))

        # ── fondos descargados ──
        fondos = []
        for carpeta in (Path.home() / "Imágenes" / "Wallpapers" / "Comunidad", DESCARGAS):
            if carpeta.is_dir():
                fondos += sorted(f for f in carpeta.rglob("*")
                                 if f.is_file() and f.suffix.lower() in EXTENSIONES)
        if fondos:
            self.flujo.append(self._cabecera_seccion(
                "Fondos descargados", "Pulsa uno para ponerlo de fondo"))
            for ruta in fondos[:48]:
                self.flujo.append(self._tarjeta_fondo_descargado(ruta))

        self.estado.set_text(
            f"{len(paletas)} paletas · {len(repos)} repos · {len(fondos)} fondos descargados"
            " · cada uno con su botón de aplicar")

    def aplicar_paleta(self, ident, nombre):
        self.estado.set_text(f"Aplicando {nombre}…")

        def trabajo():
            try:
                subprocess.run([str(PALETA), "aplicar", ident], capture_output=True, timeout=120)
            except Exception:
                pass
            GLib.idle_add(self.fin_aplicar_paleta, ident, nombre)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_aplicar_paleta(self, ident, nombre):
        self.estado.set_text(f"Tema {nombre} aplicado")
        self.ventana.pagina_paletas.cargar()
        self.mostrar_instalados()
        return False

    def ver_capturas(self, r):
        urls = r.get("capturas") or ([r.get("banner")] if r.get("banner") else [])
        ventana = VistaCapturas(self.ventana, r.get("repo", ""), urls, r.get("url", ""))
        ventana.present()

    def instalar(self, repo, boton):
        boton.set_sensitive(False)
        boton.set_label("Instalando…")
        self.estado.set_text(f"Descargando {repo} y buscando sus temas…")

        def trabajo():
            try:
                r = subprocess.run([str(TIENDA), "instalar", repo],
                                   capture_output=True, text=True, timeout=900)
                resumen = (r.stdout or "").strip().splitlines()[-1] if r.stdout.strip() else "instalado"
            except Exception:
                resumen = "no se pudo instalar"
            GLib.idle_add(self.fin_instalar, boton, resumen)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_instalar(self, boton, resumen):
        boton.set_label("Instalado")
        boton.set_sensitive(True)
        self.estado.set_text(resumen)
        self.instalados = self._instalados()
        self.ventana.pagina_paletas.cargar()
        self.ventana.pagina_paletas.generar_previas()
        # repintar los resultados: el repo recién instalado ya puede aplicarse
        if self.resultados:
            self.mostrar(self.resultados)
            self.estado.set_text(resumen + " · pulsa «Aplicar tema» para probar su aspecto")
        return False

    def auto_cargar(self):
        """La primera vez que se abre la tienda, trae resultados en vez de dejarla vacía."""
        if self._auto_hecho or self.resultados:
            self._auto_hecho = True
            return
        self._auto_hecho = True
        consulta = self.busqueda.get_text().strip() or self.CATEGORIAS[0][1]
        self.buscar(consulta)

    def recargar(self):
        """Relee lo instalado y repinta los resultados que ya había."""
        self.instalados = self._instalados()
        if self.resultados:
            self.mostrar(self.resultados)
        else:
            self.estado.set_text("Listo: instalados al día. Busca algo para ver más.")
        return False



# ────────────────────────────── complementos ────────────────────────────────
# Plugins de Hyprland que suele usar este escritorio. La descripción va en
# español y fija: así la pestaña funciona aunque no haya red.
COMPLEMENTOS = {
    "hyprbars": ("Barras de título con botones",
                 "Dibuja una barra en cada ventana con los botones de minimizar, "
                 "maximizar y cerrar (es la que usas ahora)."),
    "borders-plus-plus": ("Bordes extra y degradados",
                          "Añade bordes alrededor de las ventanas activas, con "
                          "soporte de colores y degradados."),
    "hyprfocus": ("Resalta la ventana activa",
                  "Ilumina la ventana que tiene el foco durante un instante, para "
                  "no perder de vista dónde estás escribiendo."),
    "csgo-vulkan-fix": ("Arreglo para CS:GO con Vulkan",
                        "Corrige el tamaño y la posición de ventana de CS:GO cuando "
                        "se ejecuta con Vulkan."),
}


class ComplementosPage(Gtk.Box):
    """Complementos (plugins) de Hyprland: estado y activarlos o recompilarlos."""

    def __init__(self, ventana):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.ventana = ventana
        self.fuentes = Path.home() / ".local" / "share" / "hyprland-plugins"

        barra = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        barra.add_css_class("page-toolbar")

        titulo = Gtk.Label(label="Complementos de Hyprland")
        titulo.set_xalign(0)
        titulo.set_hexpand(True)
        titulo.add_css_class("store-desc")
        barra.append(titulo)

        actualizar = Gtk.Button(label="Actualizar fuentes")
        actualizar.set_tooltip_text("Trae los últimos cambios de los complementos")
        actualizar.add_css_class("flat")
        actualizar.connect("clicked", self.on_actualizar)
        barra.append(actualizar)

        self.estado = Gtk.Label(label="")
        self.estado.set_xalign(0)
        self.estado.add_css_class("page-footer-text")
        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pie.add_css_class("page-footer")
        pie.append(self.estado)

        self.flujo = Gtk.FlowBox()
        self.flujo.set_valign(Gtk.Align.START)
        self.flujo.set_homogeneous(True)
        self.flujo.set_max_children_per_line(2)
        self.flujo.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flujo.set_margin_top(8)
        self.flujo.set_margin_bottom(12)
        self.flujo.set_margin_start(14)
        self.flujo.set_margin_end(14)
        self.flujo.set_row_spacing(10)
        self.flujo.set_column_spacing(10)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.flujo)

        self.append(scroll)

        self.append(pie)
        self.cargar()

    # ── estado ──────────────────────────────────────────────────────────────
    @staticmethod
    def cargados():
        """Nombres de los complementos cargados ahora mismo en Hyprland."""
        try:
            r = subprocess.run(["hyprctl", "plugin", "list"],
                               capture_output=True, text=True, timeout=10)
        except Exception:
            return set()
        nombres = set()
        for linea in r.stdout.splitlines():
            if linea.startswith("Plugin "):
                nombres.add(linea.split("Plugin ", 1)[1].split(" by", 1)[0].strip())
        return nombres

    def compilado(self, nombre):
        return (self.fuentes / nombre / f"{nombre}.so").exists()

    # ── interfaz ────────────────────────────────────────────────────────────
    def cargar(self):
        while (h := self.flujo.get_first_child()) is not None:
            self.flujo.remove(h)
        cargados = self.cargados()
        for nombre, (titulo, descripcion) in COMPLEMENTOS.items():
            self.flujo.append(self.tarjeta(nombre, titulo, descripcion, nombre in cargados))
        n = len(COMPLEMENTOS)
        activos = len([x for x in COMPLEMENTOS if x in cargados])
        self.estado.set_text(f"{n} complementos · {activos} activos ahora mismo")

    def tarjeta(self, nombre, titulo, descripcion, activo):
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        caja.add_css_class("store-card")

        fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        etiqueta = Gtk.Label(label=titulo)
        etiqueta.set_xalign(0)
        etiqueta.set_hexpand(True)
        etiqueta.set_ellipsize(3)
        etiqueta.add_css_class("store-title")
        fila.append(etiqueta)

        estado = Gtk.Label(label="Activo" if activo else "Inactivo")
        estado.add_css_class("store-badge")
        if activo:
            estado.add_css_class("store-badge-ok")
        fila.append(estado)
        caja.append(fila)

        paquete = Gtk.Label(label=nombre)
        paquete.set_xalign(0)
        paquete.add_css_class("store-desc")
        caja.append(paquete)

        desc = Gtk.Label(label=descripcion)
        desc.set_wrap(True)
        desc.set_lines(3)
        desc.set_ellipsize(3)
        desc.set_xalign(0)
        desc.add_css_class("store-desc")
        caja.append(desc)

        acciones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        if activo:
            boton = Gtk.Button(label="Desactivar")
            boton.add_css_class("flat")
            boton.set_tooltip_text("Descarga el complemento de esta sesión")
            boton.connect("clicked", lambda *_, n=nombre: self.accion("descargar", n))
        else:
            boton = Gtk.Button(label="Activar")
            boton.add_css_class("store-instalar")
            boton.add_css_class("suggested-action")
            boton.set_tooltip_text("Carga el complemento en Hyprland ahora")
            boton.connect("clicked", lambda *_, n=nombre: self.accion("cargar", n))
        acciones.append(boton)

        compilar = Gtk.Button(label="Recompilar")
        compilar.add_css_class("flat")
        compilar.set_tooltip_text("Recompila el complemento con make")
        compilar.connect("clicked", lambda *_, n=nombre: self.accion("compilar", n))
        acciones.append(compilar)
        caja.append(acciones)
        return caja

    # ── acciones ────────────────────────────────────────────────────────────
    def accion(self, que, nombre):
        self.estado.set_text(f"{que.capitalize()} {nombre}…")

        def trabajo():
            carpeta = self.fuentes / nombre
            so = carpeta / f"{nombre}.so"
            mensaje = ""
            try:
                if que == "cargar":
                    r = subprocess.run(["hyprctl", "plugin", "load", str(so)],
                                       capture_output=True, text=True, timeout=30)
                    mensaje = r.stdout.strip() or "cargado"
                elif que == "descargar":
                    r = subprocess.run(["hyprctl", "plugin", "unload", str(so)],
                                       capture_output=True, text=True, timeout=30)
                    mensaje = r.stdout.strip() or "descargado"
                elif que == "compilar":
                    r = subprocess.run(["make"], cwd=str(carpeta),
                                       capture_output=True, text=True, timeout=600)
                    mensaje = "recompilado" if r.returncode == 0 else "falló la compilación"
            except Exception as exc:  # noqa: BLE001
                mensaje = f"error: {exc}"
            GLib.idle_add(self.fin_accion, mensaje)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin_accion(self, mensaje):
        self.estado.set_text(mensaje)
        self.cargar()
        return False

    def on_actualizar(self, *_):
        self.estado.set_text("Actualizando fuentes de los complementos…")

        def trabajo():
            try:
                r = subprocess.run(["git", "pull", "--ff-only"], cwd=str(self.fuentes),
                                   capture_output=True, text=True, timeout=180)
                mensaje = "fuentes actualizadas" if r.returncode == 0 else "no se pudo actualizar"
            except Exception:
                mensaje = "no se pudo actualizar"
            GLib.idle_add(self.fin_accion, mensaje)

        threading.Thread(target=trabajo, daemon=True).start()


# ────────────────────────────── descarga ────────────────────────────────────
class VentanaDescarga(Gtk.Window):
    """Descarga fondos 2560x1440 y los añade a la lista de temas."""

    FUENTE = "https://picsum.photos/2560/1440"

    def __init__(self, padre):
        super().__init__(title="Descargar fondos", transient_for=padre, modal=True)
        self.set_default_size(460, 260)
        self.padre = padre

        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        caja.set_margin_top(16)
        caja.set_margin_bottom(16)
        caja.set_margin_start(16)
        caja.set_margin_end(16)

        titulo = Gtk.Label(label="Descargar fondos nuevos")
        titulo.add_css_class("title-3")
        titulo.set_xalign(0)
        caja.append(titulo)

        ayuda = Gtk.Label(
            label=(
                "Se descargan fotos de 2560×1440 a "
                "~/Imágenes/Wallpapers/Descargados y se añaden al final de la "
                "lista de temas. Luego aparecen aquí con su miniatura."
            )
        )
        ayuda.set_wrap(True)
        ayuda.set_xalign(0)
        ayuda.add_css_class("dim-label")
        caja.append(ayuda)

        fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        fila.append(Gtk.Label(label="Cuántos:"))
        self.spin = Gtk.SpinButton.new_with_range(1, 10, 1)
        self.spin.set_value(4)
        fila.append(self.spin)
        caja.append(fila)

        self.barra = Gtk.ProgressBar()
        self.barra.set_show_text(True)
        caja.append(self.barra)

        self.progreso_texto = Gtk.Label(label="")
        self.progreso_texto.set_xalign(0)
        caja.append(self.progreso_texto)

        botones = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        botones.set_halign(Gtk.Align.END)
        self.btn_cancelar = Gtk.Button(label="Cerrar")
        self.btn_cancelar.connect("clicked", lambda *_: self.close())
        self.btn_empezar = Gtk.Button(label="Descargar")
        self.btn_empezar.add_css_class("suggested-action")
        self.btn_empezar.connect("clicked", self.on_descargar)
        botones.append(self.btn_cancelar)
        botones.append(self.btn_empezar)
        caja.append(botones)

        self.set_child(caja)

    def on_descargar(self, *_):
        n = int(self.spin.get_value())
        self.btn_empezar.set_sensitive(False)
        self.barra.set_fraction(0)

        def trabajo():
            DESCARGAS.mkdir(parents=True, exist_ok=True)
            hechos = 0
            for i in range(n):
                GLib.idle_add(self.barra.set_fraction, i / n)
                GLib.idle_add(self.progreso_texto.set_text, f"Descargando {i + 1} de {n}…")
                destino = DESCARGAS / f"descargado-{_sello()}-{i + 1}.jpg"
                if not _descargar(self.FUENTE, destino):
                    continue
                numero = contar_descargados() + 1
                with LISTA.open("a", encoding="utf-8") as fh:
                    fh.write(f"Descargado {numero}|{destino}|{ICONO_POR_DEFECTO}\n")
                hechos += 1
            GLib.idle_add(self.fin, hechos, n)

        threading.Thread(target=trabajo, daemon=True).start()

    def fin(self, hechos, n):
        self.barra.set_fraction(1)
        self.progreso_texto.set_text(f"Listo: {hechos} de {n} fondos añadidos.")
        self.padre.cargar()
        return False


def abrir_carpeta(ruta):
    """Abre una CARPETA en el gestor de archivos del sistema."""
    if not ruta:
        return False
    for cmd in (["dolphin", ruta],
                ["nemo", ruta],
                ["thunar", ruta],
                ["nautilus", "--new-window", ruta]):
        if not shutil.which(cmd[0]):
            continue
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
        except Exception:
            continue
    return False


def abrir_url(url):
    """Abre una URL en el NAVEGADOR (nunca en el gestor de archivos)."""
    if not url:
        return False
    for cmd in (["xdg-open", url],
                ["brave", url],
                ["brave-origin", url],
                ["firefox", url]):
        if not shutil.which(cmd[0]):
            continue
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
        except Exception:
            continue
    return False


def abrir_imagen(ruta):
    """Abre una imagen local con el visor de imágenes del sistema."""
    for cmd in (["xdg-open", ruta],
                ["gwenview", ruta],
                ["loupe", ruta],
                ["eog", ruta],
                ["imv", ruta]):
        if not shutil.which(cmd[0]):
            continue
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
        except Exception:
            continue
    return False


def contar_descargados():
    """Cuántos fondos llevamos ya bajados con el botón Descargar."""
    try:
        texto = LISTA.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return 0
    return sum(1 for linea in texto.splitlines() if linea.strip().startswith("Descargado "))


def _sello():
    import datetime

    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def _descargar(url: str, destino: Path) -> bool:
    curl = shutil.which("curl")
    if not curl:
        return False
    try:
        r = subprocess.run(
            [curl, "-sSL", "--max-time", "60", "-o", str(destino), url],
            check=False, capture_output=True,
        )
        return r.returncode == 0 and destino.exists() and destino.stat().st_size > 10000
    except Exception:
        return False


# ────────────────────────────── app ─────────────────────────────────────────
class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="es.david.HyprBazar")
        self.ventana = None

    def do_activate(self):
        if self.ventana is None:
            self.ventana = Ventana(self)
        self.ventana.present()


def main():
    app = App()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
