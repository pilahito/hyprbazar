def leer_paleta_dms():
    """Colores Material You que usa DMS ahora mismo (o unos por defecto)."""
    paleta = dict(_PALETA_POR_DEFECTO)
    try:
        datos = json.loads(DMS_COLORES.read_text(encoding="utf-8"))
        modo = datos.get("mode", "dark")
        colores = datos.get("colors", {}).get(modo) or {}
        for clave, valor in colores.items():
            if isinstance(valor, str) and valor.startswith("#"):
                paleta[clave] = valor
    except Exception:
        pass
    return paleta


