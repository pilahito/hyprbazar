_PROVEEDOR_PALETA = None
_VIGILANTE_PALETA = None


def recolorear_app(*_):
    """(Re)aplica los colores de DMS; se llama al abrir y cada vez que cambian."""
    global _PROVEEDOR_PALETA
    pantalla = Gdk.Display.get_default()
    if pantalla is None:
        return False
    nuevo = Gtk.CssProvider()
    try:
        nuevo.load_from_data(css_paleta(leer_paleta_dms()).encode("utf-8"))
    except Exception as e:  # una paleta rara no debe tumbar la app
        print("HyprBazar: no pude aplicar la paleta:", e, file=sys.stderr)
        return False
    if _PROVEEDOR_PALETA is not None:
        Gtk.StyleContext.remove_provider_for_display(pantalla, _PROVEEDOR_PALETA)
    Gtk.StyleContext.add_provider_for_display(
        pantalla, nuevo, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    _PROVEEDOR_PALETA = nuevo
    return False


def vigilar_paleta():
    """Si DMS cambia de colores (nuevo fondo), la app se recolorea sola."""
    global _VIGILANTE_PALETA
    if _VIGILANTE_PALETA is not None:
        return
    try:
        vig = Gio.File.new_for_path(str(DMS_COLORES)).monitor_file(Gio.FileMonitorFlags.NONE, None)
    except Exception:
        return
    pendiente = {"id": 0}

    def cambio(*_):
        if pendiente["id"]:
            GLib.source_remove(pendiente["id"])

        def hacer():
            pendiente["id"] = 0
            recolorear_app()
            return False
        pendiente["id"] = GLib.timeout_add(500, hacer)

    vig.connect("changed", cambio)
    _VIGILANTE_PALETA = vig


def icono_disponible(*nombres):
    """Primer icono de la lista que exista en el tema de iconos."""
    try:
        tema = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        for n in nombres:
            if tema.has_icon(n):
                return n
    except Exception:
        pass
    return nombres[-1]


def estado_vacio(icono, titulo, texto):
    """Bloque centrado con icono grande, título y explicación."""
    caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    caja.set_halign(Gtk.Align.CENTER)
    caja.set_valign(Gtk.Align.CENTER)
    caja.set_margin_top(60)
    caja.set_margin_bottom(40)
    img = Gtk.Image.new_from_icon_name(icono_disponible(icono, "system-search-symbolic"))
    img.set_pixel_size(64)
    img.add_css_class("hb-vacio-icono")
    caja.append(img)
    t = Gtk.Label(label=titulo)
    t.add_css_class("hb-vacio-titulo")
    caja.append(t)
    d = Gtk.Label()
    d.set_markup(texto)
    d.set_wrap(True)
    d.set_max_width_chars(60)
    d.set_justify(Gtk.Justification.CENTER)
    d.add_css_class("hb-vacio-texto")
    caja.append(d)
    return caja


