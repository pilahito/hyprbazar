def _local_bin(nombre, alternativo):
    """Busca el ejecutable con el nombre nuevo y, si no, con el antiguo."""
    for candidato in (shutil.which(nombre), Path.home() / ".local" / "bin" / nombre):
        if candidato and Path(candidato).exists():
            return Path(candidato)
    return Path.home() / ".local" / "bin" / alternativo


