#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
teclado-sonido — sonido de teclado al escribir, para Wayland/Hyprland.

Lee directamente los teclados de /dev/input (hace falta estar en el grupo
"input") y reproduce un sonido con cada pulsación. No necesita X11, ni sudo,
ni ningún servicio aparte.

Uso:
    teclado-sonido                       # pack por defecto
    teclado-sonido -s cherrymx-blue-pbt  # elegir pack
    teclado-sonido -V 40                 # volumen (por defecto 60)
    teclado-sonido -l                    # listar packs disponibles

Los packs de sonido son los de MechSim (licencia del proyecto original) y se
buscan en ~/.local/share/mechsim/audio/<pack>/. Se usa su fichero
config.json: si el pack tiene un solo sonido (sound.ogg) se reproduce ese, y
si tiene varios se elige uno al azar entre los de pulsación.
"""
import argparse
import json
import random
import shutil
import subprocess
import sys
from pathlib import Path

try:
    import evdev
    from evdev import ecodes
except ImportError:
    print("Falta python-evdev (paquete python-evdev).", file=sys.stderr)
    sys.exit(1)

PAQUETES = Path.home() / ".local" / "share" / "mechsim" / "audio"
CONFIG = Path.home() / ".config" / "hyprbazar" / "sonido.json"


def leer_config():
    """Ajustes guardados desde HyprBazar (pack, volumen y si está activo)."""
    try:
        return json.loads(CONFIG.read_text(encoding="utf-8"))
    except Exception:
        return {}


def guardar_config(datos):
    try:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(datos, ensure_ascii=False, indent=2), encoding="utf-8")
    except Exception:
        pass
SEPARACION_MINIMA = 0.012  # segundos entre sonidos (evita ráfagas)


def packs():
    if not PAQUETES.is_dir():
        return []
    return sorted(p.name for p in PAQUETES.iterdir() if p.is_dir())


def cargar_pack(nombre):
    """Devuelve la lista de ficheros de sonido del pack."""
    carpeta = PAQUETES / nombre
    if not carpeta.is_dir():
        raise SystemExit(f"No existe el pack '{nombre}'. Prueba: teclado-sonido -l")

    sonidos = []
    config = carpeta / "config.json"
    if config.exists():
        try:
            datos = json.loads(config.read_text(encoding="utf-8"))
            # single: un solo fichero; definidos: uno por tecla
            if isinstance(datos.get("sound"), str):
                sonidos.append(carpeta / datos["sound"])
            for clave in ("defines", "packs", "generic"):
                valor = datos.get(clave)
                if isinstance(valor, dict):
                    for v in valor.values():
                        if isinstance(v, str):
                            sonidos.append(carpeta / v)
                        elif isinstance(v, list):
                            sonidos += [carpeta / x for x in v if isinstance(x, str)]
                elif isinstance(valor, list):
                    sonidos += [carpeta / x for x in valor if isinstance(x, str)]
        except Exception:
            pass

    if not sonidos:
        sonidos = sorted(carpeta.glob("*.ogg")) + sorted(carpeta.glob("*.wav"))
    sonidos = [s for s in sonidos if s.exists()]
    if not sonidos:
        raise SystemExit(f"El pack '{nombre}' no tiene sonidos utilizables.")
    return trozos_de_pack(nombre, carpeta, sonidos)


def reproductor():
    """Programa para reproducir. paplay primero: es ligero y sí acepta volumen.

    (pw-play NO tiene opción --volume: si se le pasa, falla y no suena nada.)
    """
    for cmd in ("paplay", "ffplay", "pw-play"):
        if shutil.which(cmd):
            return cmd
    raise SystemExit("No encuentro paplay, ffplay ni pw-play para reproducir.")


# Dispositivos que NO deben sonar: los crea software de automatización
# (ydotool/uinput) y son los que usa el agente para mover el ratón y teclear.
VIRTUALES = ("ydotool", "virtual", "uinput", "warp", "autopilot", "fake")
VENDOR_YDOTOOL = 0x2333


def es_virtual(aparato):
    nombre = (aparato.name or "").lower()
    if any(pista in nombre for pista in VIRTUALES):
        return True
    if aparato.info.vendor == VENDOR_YDOTOOL:
        return True
    return False


def teclados():
    aparatos = []
    for ruta in evdev.list_devices():
        try:
            aparato = evdev.InputDevice(ruta)
        except Exception:
            continue
        teclas = aparato.capabilities().get(ecodes.EV_KEY, [])
        # solo teclados de verdad: tienen letras
        if ecodes.KEY_A in teclas and ecodes.KEY_Z in teclas:
            if es_virtual(aparato):
                continue          # teclado simulado: no suena
            aparatos.append(aparato)
    return aparatos



# ── Trocear packs de un solo fichero largo ─────────────────────
#
# Muchos packs de MechSim traen un único son.ogg de ~54 s que en realidad es
# una grabación de tecleo: varios golpes separados por silencio. Reproducir ese
# fichero entero en cada tecla es un desastre, así que la primera vez lo
# partimos en golpes cortos (silencios + corte con ffmpeg) y los guardamos en
# caché. A partir de ahí se reproducen trozos de ~100 ms.

CACHE_TROZOS = Path.home() / ".cache" / "teclado-sonido"
TROZO_MAX = 0.30          # segundos como mucho por golpe
TROZOS_MAXIMOS = 48       # cuántos golpes distintos guardamos por pack


def duracion(fichero):
    try:
        r = subprocess.run(["ffprobe", "-v", "error", "-show_entries",
                            "format=duration", "-of", "csv=p=0", str(fichero)],
                           capture_output=True, text=True, timeout=20)
        return float(r.stdout.strip())
    except Exception:
        return 0.0


def golpes_de(fichero):
    """Devuelve [(inicio, duración)] de cada golpe detectado en la grabación."""
    try:
        r = subprocess.run(
            ["ffmpeg", "-hide_banner", "-i", str(fichero), "-af",
             "silencedetect=noise=-35dB:d=0.02", "-f", "null", "-"],
            capture_output=True, text=True, timeout=90)
    except Exception:
        return []
    texto = r.stderr
    inicios, finales = [], []
    for linea in texto.splitlines():
        if "silence_start:" in linea:
            try:
                inicios.append(float(linea.split("silence_start:")[1].split()[0]))
            except Exception:
                pass
        elif "silence_end:" in linea:
            try:
                finales.append(float(linea.split("silence_end:")[1].split()[0]))
            except Exception:
                pass
    # los tramos con sonido están entre el final de un silencio y el siguiente
    golpes = []
    if not inicios:
        return []
    for pos, fin in enumerate(finales):
        siguiente = inicios[pos + 1] if pos + 1 < len(inicios) else fin + 0.3
        largo = siguiente - fin
        if 0.02 <= largo <= TROZO_MAX:
            # se empieza un pelín antes para no cortar el ataque de la tecla
            inicio = max(0.0, fin - 0.015)
            golpes.append((inicio, min(largo + 0.03, TROZO_MAX + 0.05)))
        if len(golpes) >= TROZOS_MAXIMOS:
            break
    return golpes


def trozos_de_pack(nombre, carpeta, sonidos):
    """Si el pack es un único fichero largo, lo parte y devuelve los trozos."""
    largos = [s for s in sonidos if duracion(s) > 1.5]
    cortos = [s for s in sonidos if s not in largos]
    if not largos:
        return sonidos

    destino = CACHE_TROZOS / nombre
    destino.mkdir(parents=True, exist_ok=True)
    existentes = sorted(destino.glob("*.ogg"))
    if len(existentes) >= 5:
        return cortos + existentes

    for fichero in largos:
        for i, (inicio, largo) in enumerate(golpes_de(fichero)):
            salida = destino / f"{i:02d}.ogg"
            if salida.exists():
                continue
            try:
                subprocess.run(
                    # normalización: los trozos venían a -26 dB de media y con
                    # el volumen al 30 % no se oían. Se suben a ~-16 LUFS.
                    ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
                     "-ss", f"{inicio:.3f}", "-t", f"{largo:.3f}",
                     "-i", str(fichero), "-af",
                     "loudnorm=I=-16:TP=-1.5:LRA=11,afade=t=out:st="
                     f"{max(0.0, largo - 0.02):.3f}:d=0.02",
                     "-c:a", "libvorbis", "-q:a", "4", str(salida)],
                    capture_output=True, timeout=30)
            except Exception:
                continue

    trozos = sorted(destino.glob("*.ogg"))
    if trozos:
        print(f"teclado-sonido: pack '{nombre}' troceado en {len(trozos)} golpes "
              f"(la primera vez tarda unos segundos)", flush=True)
    return cortos + trozos


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("-s", "--sound", default=None)
    ap.add_argument("-V", "--volume", type=int, default=None)
    ap.add_argument("-l", "--list", action="store_true")
    args = ap.parse_args()

    if args.list:
        for p in packs():
            print(" ", p)
        return 0

    # si no se indica nada por línea de órdenes, se usan los ajustes guardados
    guardado = leer_config()
    pack = args.sound or guardado.get("pack") or "cherrymx-blue-pbt"
    if args.volume is not None:
        volumen_pedido = args.volume
    else:
        volumen_pedido = guardado.get("volumen", 40)

    sonidos = cargar_pack(pack)
    programa = reproductor()
    volumen = max(0, min(100, int(volumen_pedido)))

    aparatos = teclados()
    if not aparatos:
        print(
            "No encuentro ningún teclado en /dev/input.\n"
            "Comprueba que estás en el grupo 'input' (groups | grep input).",
            file=sys.stderr,
        )
        return 1

    print(f"teclado-sonido: {len(aparatos)} teclado(s), pack '{pack}', "
          f"volumen {volumen}%", flush=True)

    import selectors
    import time

    ultimo = 0.0
    # el volumen se puede cambiar en caliente desde HyprBazar: se vuelve a
    # leer sonido.json cuando cambia (sin reiniciar este programa)
    try:
        marca_config = CONFIG.stat().st_mtime
    except Exception:
        marca_config = 0.0
    revisado = time.monotonic()
    sel = selectors.DefaultSelector()
    for aparato in aparatos:
        sel.register(aparato, selectors.EVENT_READ)

    try:
        while True:
            if time.monotonic() - revisado > 0.4:
                revisado = time.monotonic()
                try:
                    m = CONFIG.stat().st_mtime
                except Exception:
                    m = marca_config
                if m != marca_config:
                    marca_config = m
                    try:
                        volumen = max(0, min(100, int(leer_config().get("volumen", volumen))))
                    except Exception:
                        pass
            for clave, _ in sel.select(timeout=0.5):
                aparato = clave.fileobj
                try:
                    for evento in aparato.read():
                        if evento.type != ecodes.EV_KEY:
                            continue
                        if evento.value != 1:      # solo al pulsar
                            continue
                        ahora = time.monotonic()
                        if ahora - ultimo < SEPARACION_MINIMA:
                            continue
                        ultimo = ahora
                        if volumen <= 0:
                            continue
                        archivo = random.choice(sonidos)
                        # Cada reproductor usa su propia forma de poner el volumen:
                        #   paplay  0..65536 (0 % .. 100 %)
                        #   ffplay  -volume 0..100
                        #   pw-play no admite volumen (se toca el del sink)
                        if programa == "paplay":
                            orden = [programa, f"--volume={int(volumen * 655.36)}",
                                     "--client-name=Sonido de teclas",
                                     "--property=application.icon_name=input-keyboard",
                                     str(archivo)]
                        elif programa == "ffplay":
                            orden = [programa, "-nodisp", "-autoexit", "-loglevel",
                                     "quiet", "-volume", str(volumen), str(archivo)]
                        else:
                            orden = [programa, str(archivo)]
                        subprocess.Popen(orden, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL,
                                         start_new_session=True)
                except OSError:
                    # dispositivo desconectado: se quita de la lista
                    try:
                        sel.unregister(aparato)
                    except Exception:
                        pass
    except KeyboardInterrupt:
        pass
    finally:
        for aparato in aparatos:
            try:
                aparato.close()
            except Exception:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
