#!/usr/bin/env bash
# hyprbazar-escritorio — instala un rice de otro escritorio (BSPWM, i3…) como
# ESCRITORIO APARTE: sus paquetes y su configuración, sin tocar la tuya.
#
#   · Paquetes: se leen de la lista que trae el instalador del propio repo
#     (variable dependencies="…"), pero NO se ejecuta ese instalador.
#     Los de los repos oficiales van con pacman; los que solo estén en AUR,
#     con paru/yay. Nunca se añaden repositorios de terceros.
#   · Configuración: se copian las carpetas config/<app> que todavía NO tengas.
#     Las que ya existen (kitty, nvim…) se dejan como están, para que tu
#     Hyprland no cambie. Nunca se copian servicios (systemd) ni tu .zshrc.
#   · Al terminar, en la pantalla de inicio de sesión eliges el escritorio.
#
# Uso:
#   hyprbazar-escritorio revisar  <owner/repo>   qué instalaría (sin cambiar nada)
#   hyprbazar-escritorio instalar <owner/repo>   lo instala
set -uo pipefail

DATOS="${XDG_DATA_HOME:-$HOME/.local/share}/tienda"
EXCLUIR_CONFIG="systemd paru yay gtk-3.0 gtk-4.0 autostart environment.d"
NO_NECESARIOS="rustup paru paru-git yay yay-git"   # herramientas que no hacen falta (o que ya tienes de otra forma)

log() { printf '%s\n' "$*" >&2; }

# Ejecuta como administrador pidiendo la contraseña de la forma que funcione aquí:
#   · en una terminal → sudo (la pide ahí mismo)
#   · sin terminal, con un agente gráfico de polkit → pkexec (ventana de contraseña)
#   · sin nada de eso → abre una terminal para pedirla con sudo
como_root() {
    if [ -t 0 ]; then
        sudo "$@"
    elif pgrep -f 'polkit.*agent|hyprpolkitagent|polkit-gnome-authentication|lxpolkit|polkit-kde|soteria' >/dev/null 2>&1 \
         && command -v pkexec >/dev/null; then
        pkexec "$@"
    else
        local term; term="$(command -v kitty || command -v alacritty || command -v foot || true)"
        if [ -n "$term" ]; then
            "$term" -e sh -c 'echo "HyprBazar necesita tu contraseña para instalar:"; echo "  $*"; sudo "$@"; s=$?; echo; read -r -p "Pulsa Intro para cerrar " _; exit $s' sh "$@"
        else
            log "no hay terminal ni agente de contraseñas; ejecuta: sudo $*"; return 1
        fi
    fi
}

repo_local() {
    local repo="$1" slug destino
    slug="$(printf '%s' "$repo" | tr '/' '-')"
    destino="$DATOS/escritorios/$slug"
    if [ -d "$destino/.git" ]; then
        git -C "$destino" fetch --depth 1 origin >/dev/null 2>&1 && git -C "$destino" reset --hard FETCH_HEAD >/dev/null 2>&1
    else
        mkdir -p "$(dirname "$destino")"
        git clone --depth 1 "https://github.com/$repo.git" "$destino" >/dev/null 2>&1 || { log "no pude descargar $repo"; return 1; }
    fi
    printf '%s\n' "$destino"
}

# Paquetes que pide el repo (solo se LEE): listas de texto, variables de los scripts
# de instalación y órdenes «pacman/yay/paru -S …» de los scripts y del README.
paquetes_del_repo() {
    local dir="$1" f
    {
        # 1) archivos que son una lista de paquetes (uno por línea)
        while IFS= read -r f; do
            sed -E 's/#.*//' "$f" | awk 'NF{print $1}'
        done < <(find "$dir" -maxdepth 3 -type f -not -path '*/.git/*' \
                 \( -iname 'pkglist*' -o -iname 'packages*.txt' -o -iname 'pkgs*.txt' -o -iname 'paquetes*.txt' \
                    -o -iname 'dependencies*.txt' -o -iname 'deps*.txt' -o -iname 'arch-pkgs*' \) -size -200k)
        # 2) variables tipo dependencies="a b c" en los instaladores
        while IFS= read -r f; do
            grep -hoE '^[[:space:]]*([a-zA-Z_]+_)?(dependencies|deps|packages|pkgs)=\(?"?[^")]+' "$f" 2>/dev/null \
                | sed -E 's/^[^=]*=\(?"?//'
        done < <(find "$dir" -maxdepth 3 -type f -not -path '*/.git/*' \
                 \( -name '*.sh' -o -name 'RiceInstaller' -o -name 'install*' -o -name 'Install*' -o -name 'setup*' \) -size -400k)
        # 3) «pacman -S …», «yay -S …», «paru -S …» en scripts y README
        while IFS= read -r f; do
            grep -hE '(pacman|yay|paru)[[:space:]]+(-[A-Za-z-]+[[:space:]]+)*-S' "$f" 2>/dev/null \
                | sed -E 's/.*[[:space:]]-S[A-Za-z]*[[:space:]]+//; s/[&;|#>].*//; s/\\$//'
        done < <(find "$dir" -maxdepth 3 -type f -not -path '*/.git/*' \
                 \( -name '*.sh' -o -name 'RiceInstaller' -o -name 'install*' -o -name 'setup*' -o -iname 'README*.md' \) -size -400k)
    } | tr ' ' '\n' | grep -E '^[a-z0-9][a-z0-9@._+-]{1,}$' | grep -vxE 'sudo|install|upgrade|update|sync|refresh|needed|noconfirm|confirm|yes|none|all|and|the|for|with|from|your|git|clone|make|build|run|sh|bash' | sort -u | grep -vxF -f <(printf '%s\n' $NO_NECESARIOS)
}

# ¿Existe de verdad en AUR? (evita intentar instalar palabras sueltas que no son paquetes)
existe_en_aur() {
    local n; n="$(curl -fsS --max-time 15 "https://aur.archlinux.org/rpc/v5/info?arg[]=$1" 2>/dev/null | jq -r '.resultcount // 0' 2>/dev/null)"
    [ "${n:-0}" -ge 1 ]
}

clasificar() {   # imprime "oficial <pkg>", "aur <pkg>" o "ya <pkg>"
    local p
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if pacman -Qq "$p" >/dev/null 2>&1; then printf 'ya %s\n' "$p"
        elif pacman -Si "$p" >/dev/null 2>&1; then printf 'oficial %s\n' "$p"
        elif existe_en_aur "$p"; then printf 'aur %s\n' "$p"
        else :; fi
    done
}

carpeta_config() {   # dónde guarda el repo sus configuraciones
    local dir="$1" base
    for base in config .config dots/.config dots/config home/.config dotfiles/.config; do
        [ -d "$dir/$base" ] && { printf '%s\n' "$dir/$base"; return 0; }
    done
    return 1
}

configs() {   # imprime "copiar <app>" o "existe <app>"
    local base d app
    base="$(carpeta_config "$1")" || return 0
    for d in "$base"/*/; do
        [ -d "$d" ] || continue
        app="$(basename "$d")"
        case " $EXCLUIR_CONFIG " in *" $app "*) continue ;; esac
        if [ -e "$HOME/.config/$app" ]; then printf 'existe %s\n' "$app"; else printf 'copiar %s\n' "$app"; fi
    done
}

revisar() {
    local dir; dir="$(repo_local "$1")" || return 1
    local lista; lista="$(paquetes_del_repo "$dir" | clasificar)"
    printf 'Paquetes oficiales a instalar: %s\n' "$(printf '%s\n' "$lista" | awk '$1=="oficial"{printf "%s ", $2}')"
    printf 'Paquetes de AUR a instalar:    %s\n' "$(printf '%s\n' "$lista" | awk '$1=="aur"{printf "%s ", $2}')"
    printf 'Ya instalados:                 %s\n' "$(printf '%s\n' "$lista" | awk '$1=="ya"{n++} END{print n+0}')"
    printf 'Configuración que se copia:    %s\n' "$(configs "$dir" | awk '$1=="copiar"{printf "%s ", $2}')"
    [ -n "$lista" ] || printf 'AVISO: no encontré la lista de paquetes de este repo; mira su README e instala a mano lo que pida.\n'
    printf 'Se deja la tuya (ya existe):   %s\n' "$(configs "$dir" | awk '$1=="existe"{printf "%s ", $2}')"
}

instalar() {
    # Una sola instalación a la vez y en orden: la siguiente espera su turno (pacman bloquea su base de datos).
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hyprbazar-escritorio.lock"
    if ! flock -n 9; then log "hay otra instalación en curso; espero mi turno…"; flock 9; fi
    local dir; dir="$(repo_local "$1")" || return 1
    local lista oficiales aur
    lista="$(paquetes_del_repo "$dir" | clasificar)"
    mapfile -t oficiales < <(printf '%s\n' "$lista" | awk '$1=="oficial"{print $2}')
    mapfile -t aur < <(printf '%s\n' "$lista" | awk '$1=="aur"{print $2}')

    if [ "${#oficiales[@]}" -gt 0 ]; then
        log "instalando ${#oficiales[@]} paquetes oficiales…"
        como_root pacman -S --needed --noconfirm "${oficiales[@]}" || { log "ERROR: pacman no pudo instalar los paquetes; no sigo (revisa el mensaje de arriba)"; return 1; }
    fi
    if [ "${#aur[@]}" -gt 0 ]; then
        local ayudante; ayudante="$(command -v paru || command -v yay || true)"
        if [ -n "$ayudante" ]; then
            log "instalando ${#aur[@]} paquetes de AUR con $(basename "$ayudante")…"
            local p
            for p in "${aur[@]}"; do
                # se enseña la salida (compilar puede tardar y puede pedir la contraseña)
                if "$ayudante" -S --needed --noconfirm "$p"; then
                    log "  ✓ $p"
                elif [ "${p%-git}" != "$p" ] && "$ayudante" -S --needed --noconfirm "${p%-git}"; then
                    log "  ✓ ${p%-git} (versión estable en lugar de $p)"
                else
                    log "  ✗ $p (no está en AUR o no se pudo compilar)"
                fi
            done
        else
            log "faltan de AUR (instálalos a mano): ${aur[*]}"
        fi
    fi

    local app copiadas=0
    while read -r accion app; do
        [ "$accion" = copiar ] || continue
        cp -a "$(carpeta_config "$dir")/$app" "$HOME/.config/$app" && copiadas=$((copiadas + 1))
    done < <(configs "$dir")
    # scripts y binarios del rice que se lanzan desde su configuración
    [ -d "$dir/home/.local/bin" ] && mkdir -p "$HOME/.local/bin" && cp -an "$dir/home/.local/bin/." "$HOME/.local/bin/" 2>/dev/null
    log "configuración copiada: $copiadas carpetas (las que ya tenías se han dejado igual)"

    local sesion=""
    for s in /usr/share/xsessions/*.desktop /usr/share/wayland-sessions/*.desktop; do
        [ -f "$s" ] || continue
        case "$(basename "$s")" in bspwm*|i3*|awesome*|qtile*|openbox*|herbstluft*|dwm*) sesion="$(sed -n 's/^Name=//p' "$s" | head -1)";; esac
    done
    [ -n "$lista" ] || log "AVISO: este repo no declara paquetes que pueda leer; instala a mano lo que pida su README antes de usarlo."
    printf 'listo %s: cierra sesión y en la pantalla de inicio elige «%s»\n' "$1" "${sesion:-el nuevo escritorio}"
}

case "${1:-}" in
    revisar)  [ -n "${2:-}" ] || { log "uso: hyprbazar-escritorio revisar <owner/repo>"; exit 1; }; revisar "$2" ;;
    instalar) [ -n "${2:-}" ] || { log "uso: hyprbazar-escritorio instalar <owner/repo>"; exit 1; }; instalar "$2" ;;
    *) sed -n '2,17p' "$0"; exit 1 ;;
esac
